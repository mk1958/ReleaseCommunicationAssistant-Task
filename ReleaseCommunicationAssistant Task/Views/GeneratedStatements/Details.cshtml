@model ReleaseCommunicationAssistant_Task.Models.GeneratedStatements

@{
    ViewData["Title"] = "Statement Details";
}

<style>
    body {
        background: #f1f5f9;
    }

    .details-page {
        padding: 30px;
    }

    /* Header */
    .details-header {
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
        color: white;
        padding: 28px 32px;
        border-radius: 18px;
        margin-bottom: 25px;
        box-shadow: 0 10px 30px rgba(15, 23, 42, 0.18);
    }

        .details-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
        }

        .details-header p {
            margin: 8px 0 0;
            color: #cbd5e1;
            font-size: 14px;
        }

    /* Main Card */
    .details-card {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.07);
        overflow: hidden;
    }

    /* Card Header */
    .card-header-custom {
        padding: 22px 28px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .card-title {
        margin: 0;
        font-size: 18px;
        font-weight: 700;
        color: #0f172a;
    }

    .statement-code {
        display: inline-block;
        background: #eef2ff;
        color: #3730a3;
        padding: 6px 10px;
        border-radius: 6px;
        font-family: Consolas, monospace;
        font-size: 11px;
        font-weight: 600;
    }

    /* Details */
    .details-body {
        padding: 28px;
    }

    .detail-section {
        margin-bottom: 30px;
    }

        .detail-section:last-child {
            margin-bottom: 0;
        }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e2e8f0;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .detail-item {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 15px 17px;
    }

    .detail-label {
        display: block;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 7px;
    }

    .detail-value {
        color: #0f172a;
        font-size: 14px;
        font-weight: 500;
        word-break: break-word;
    }

    .statement-content {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 4px solid #2563eb;
        border-radius: 10px;
        padding: 18px;
        color: #334155;
        line-height: 1.7;
        font-size: 14px;
        white-space: pre-wrap;
    }

    .evidence-content {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 16px;
        color: #475569;
        font-size: 13px;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    /* Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-technical {
        background: #e0f2fe;
        color: #0369a1;
    }

    .badge-stakeholder {
        background: #f3e8ff;
        color: #7e22ce;
    }

    .badge-high {
        background: #fee2e2;
        color: #b91c1c;
    }

    .badge-medium {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-low {
        background: #dcfce7;
        color: #166534;
    }

    .badge-supported {
        background: #dcfce7;
        color: #166534;
    }

    .badge-unsupported {
        background: #fee2e2;
        color: #b91c1c;
    }

    .badge-current {
        background: #dcfce7;
        color: #166534;
    }

    .badge-stale {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-draft {
        background: #e0e7ff;
        color: #3730a3;
    }

    .badge-edited {
        background: #dbeafe;
        color: #1d4ed8;
    }

    .badge-approved {
        background: #dcfce7;
        color: #166534;
    }

    .badge-rejected {
        background: #fee2e2;
        color: #b91c1c;
    }

    /* Metadata */
    .metadata {
        color: #64748b;
        font-size: 12px;
    }

    /* Footer */
    .details-footer {
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        padding: 18px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .btn-edit {
        background: #2563eb;
        color: white !important;
        padding: 9px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-edit:hover {
            background: #1d4ed8;
            transform: translateY(-1px);
        }

    .btn-back {
        background: white;
        border: 1px solid #cbd5e1;
        color: #475569 !important;
        padding: 9px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-back:hover {
            background: #f1f5f9;
            color: #334155 !important;
        }

    /* Responsive */
    @@media (max-width: 768px) {
        .details-page {
            padding: 18px;
        }

        .details-body {
            padding: 20px;
        }

        .detail-grid {
            grid-template-columns: 1fr;
        }

        .card-header-custom,
        .details-footer {
            flex-direction: column;
            align-items: flex-start;
        }

        .btn-edit,
        .btn-back {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="details-page">

    <!-- HEADER -->
    <div class="details-header">
        <h1>Generated Statement Details</h1>

        <p>
            Review the generated release communication, supporting evidence,
            validation status and review information.
        </p>
    </div>

    <!-- MAIN CARD -->
    <div class="details-card">

        <!-- CARD HEADER -->
        <div class="card-header-custom">

            <div>
                <h2 class="card-title">
                    Release Communication Statement
                </h2>
            </div>

            <span class="statement-code">
                @Model.StatementCode
            </span>

        </div>

        <!-- BODY -->
        <div class="details-body">

            <!-- BASIC INFORMATION -->
            <div class="detail-section">

                <div class="section-title">
                    Basic Information
                </div>

                <div class="detail-grid">

                    <div class="detail-item">
                        <span class="detail-label">
                            Release ID
                        </span>

                        <span class="detail-value">
                            #@Model.ReleaseId
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            Statement Type
                        </span>

                        <span class="detail-value">
                            @Model.StatementType
                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            Audience
                        </span>

                        <span class="detail-value">

                            @if (Model.Audience == "Technical")
                            {
                                <span class="badge badge-technical">
                                    Technical
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-stakeholder">
                                    Stakeholder
                                </span>
                            }

                        </span>
                    </div>

                    <div class="detail-item">
                        <span class="detail-label">
                            Impact Level
                        </span>

                        <span class="detail-value">

                            @if (Model.ImpactLevel == "High")
                            {
                                <span class="badge badge-high">
                                    High
                                </span>
                            }
                            else if (Model.ImpactLevel == "Medium")
                            {
                                <span class="badge badge-medium">
                                    Medium
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-low">
                                    @Model.ImpactLevel
                                </span>
                            }

                        </span>
                    </div>

                </div>

            </div>


            <!-- STATEMENT -->
            <div class="detail-section">

                <div class="section-title">
                    Generated Statement
                </div>

                <div class="statement-content">
                    @Model.StatementText
                </div>

            </div>


            <!-- EVIDENCE -->
            <div class="detail-section">

                <div class="section-title">
                    Evidence References
                </div>

                <div class="evidence-content">

                    @if (!string.IsNullOrWhiteSpace(Model.EvidenceReferences))
                    {
                        @Model.EvidenceReferences
                    }
                    else
                    {
                        <span class="metadata">
                            No evidence references provided.
                        </span>
                    }

                </div>

            </div>


            <!-- VALIDATION -->
            <div class="detail-section">

                <div class="section-title">
                    Validation & Review
                </div>

                <div class="detail-grid">

                    <!-- Supported -->
                    <div class="detail-item">

                        <span class="detail-label">
                            Evidence Support
                        </span>

                        @if (Model.IsSupported)
                        {
                            <span class="badge badge-supported">
                                ✓ Supported
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-unsupported">
                                ✕ Unsupported
                            </span>
                        }

                    </div>

                    <!-- Freshness -->
                    <div class="detail-item">

                        <span class="detail-label">
                            Statement Freshness
                        </span>

                        @if (Model.IsStale)
                        {
                            <span class="badge badge-stale">
                                ⚠ Stale
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-current">
                                ✓ Current
                            </span>
                        }

                    </div>

                    <!-- Status -->
                    <div class="detail-item">

                        <span class="detail-label">
                            Review Status
                        </span>

                        @if (Model.Status == "Approved")
                        {
                            <span class="badge badge-approved">
                                Approved
                            </span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge badge-rejected">
                                Rejected
                            </span>
                        }
                        else if (Model.Status == "Edited")
                        {
                            <span class="badge badge-edited">
                                Edited
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-draft">
                                Draft
                            </span>
                        }

                    </div>

                    <!-- AI Model -->
                    <div class="detail-item">

                        <span class="detail-label">
                            AI Model
                        </span>

                        <span class="detail-value">
                            @if (!string.IsNullOrWhiteSpace(Model.Aimodel))
                            {
                                @Model.Aimodel
                            }
                            else
                            {
                                <span class="metadata">
                                    Not specified
                                </span>
                            }
                        </span>

                    </div>

                </div>

            </div>


            <!-- STALE REASON -->
            @if (!string.IsNullOrWhiteSpace(Model.StaleReason))
            {
                <div class="detail-section">

                    <div class="section-title">
                        Stale Reason
                    </div>

                    <div class="evidence-content">
                        @Model.StaleReason
                    </div>

                </div>
            }


            <!-- METADATA -->
            <div class="detail-section">

                <div class="section-title">
                    Record Information
                </div>

                <div class="detail-grid">

                    <div class="detail-item">

                        <span class="detail-label">
                            Created At
                        </span>

                        <span class="metadata">
                            @Model.CreatedAt
                        </span>

                    </div>

                    <div class="detail-item">

                        <span class="detail-label">
                            Updated At
                        </span>

                        <span class="metadata">
                            @Model.UpdatedAt
                        </span>

                    </div>

                </div>

            </div>

        </div>

        <!-- FOOTER -->
        <div class="details-footer">

            <a asp-action="Index"
               class="btn-back">
                ← Back to Statements
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.GeneratedStatementId"
               class="btn-edit">
                Edit Statement
            </a>

        </div>

    </div>

</div>