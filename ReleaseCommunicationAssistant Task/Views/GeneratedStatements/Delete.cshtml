@model ReleaseCommunicationAssistant_Task.Models.GeneratedStatements

@{
    ViewData["Title"] = "Delete Statement";
}

<style>
    body {
        background: #f1f5f9;
    }

    .delete-page {
        padding: 30px;
    }

    /* Header */
    .delete-header {
        background: linear-gradient(135deg, #0f172a 0%, #7f1d1d 100%);
        color: white;
        padding: 28px 32px;
        border-radius: 18px;
        margin-bottom: 25px;
        box-shadow: 0 10px 30px rgba(127, 29, 29, 0.18);
    }

        .delete-header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 700;
        }

        .delete-header p {
            margin: 8px 0 0;
            color: #fecaca;
            font-size: 14px;
        }

    /* Main Card */
    .delete-card {
        max-width: 1000px;
        margin: 0 auto;
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        box-shadow: 0 8px 25px rgba(15, 23, 42, 0.08);
        overflow: hidden;
    }

    /* Warning */
    .warning-box {
        margin: 25px 28px 0;
        padding: 17px 20px;
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-left: 4px solid #f97316;
        border-radius: 10px;
        color: #9a3412;
    }

    .warning-title {
        font-size: 14px;
        font-weight: 700;
        margin-bottom: 5px;
    }

    .warning-text {
        font-size: 12px;
        line-height: 1.5;
    }

    /* Card Header */
    .card-header-custom {
        padding: 24px 28px;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
    }

    .card-title {
        margin: 0;
        color: #0f172a;
        font-size: 19px;
        font-weight: 700;
    }

    .statement-code {
        display: inline-block;
        margin-top: 8px;
        background: #fee2e2;
        color: #991b1b;
        padding: 6px 10px;
        border-radius: 6px;
        font-family: Consolas, monospace;
        font-size: 11px;
        font-weight: 600;
    }

    /* Body */
    .delete-body {
        padding: 28px;
    }

    .section-title {
        font-size: 15px;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 16px;
        padding-bottom: 10px;
        border-bottom: 1px solid #e2e8f0;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px;
    }

    .detail-item {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 15px 17px;
    }

    .detail-label {
        display: block;
        color: #64748b;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 7px;
    }

    .detail-value {
        color: #0f172a;
        font-size: 14px;
        font-weight: 500;
        word-break: break-word;
    }

    .statement-content {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-left: 4px solid #ef4444;
        border-radius: 10px;
        padding: 18px;
        color: #334155;
        line-height: 1.7;
        font-size: 14px;
        white-space: pre-wrap;
    }

    .evidence-content {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 16px;
        color: #475569;
        font-size: 13px;
        line-height: 1.6;
        white-space: pre-wrap;
    }

    /* Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .badge-supported {
        background: #dcfce7;
        color: #166534;
    }

    .badge-unsupported {
        background: #fee2e2;
        color: #b91c1c;
    }

    .badge-current {
        background: #dcfce7;
        color: #166534;
    }

    .badge-stale {
        background: #fef3c7;
        color: #92400e;
    }

    .badge-approved {
        background: #dcfce7;
        color: #166534;
    }

    .badge-rejected {
        background: #fee2e2;
        color: #b91c1c;
    }

    .badge-draft {
        background: #e0e7ff;
        color: #3730a3;
    }

    .badge-edited {
        background: #dbeafe;
        color: #1d4ed8;
    }

    /* Footer */
    .delete-footer {
        background: #f8fafc;
        border-top: 1px solid #e2e8f0;
        padding: 20px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .delete-actions {
        display: flex;
        gap: 10px;
    }

    .btn-delete {
        background: #dc2626;
        border: none;
        color: white;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

        .btn-delete:hover {
            background: #b91c1c;
            transform: translateY(-1px);
        }

    .btn-cancel {
        background: white;
        border: 1px solid #cbd5e1;
        color: #475569 !important;
        padding: 10px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-cancel:hover {
            background: #f1f5f9;
            color: #334155 !important;
        }

    .metadata {
        color: #64748b;
        font-size: 12px;
    }

    /* Responsive */
    @@media (max-width: 768px) {

        .delete-page {
            padding: 18px;
        }

        .delete-body {
            padding: 20px;
        }

        .detail-grid {
            grid-template-columns: 1fr;
        }

        .delete-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .delete-actions {
            flex-direction: column;
        }

        .btn-delete,
        .btn-cancel {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="delete-page">

    <!-- HEADER -->
    <div class="delete-header">

        <h1>Delete Generated Statement</h1>

        <p>
            Review the statement carefully before permanently deleting it.
        </p>

    </div>


    <!-- MAIN CARD -->
    <div class="delete-card">

        <!-- WARNING -->
        <div class="warning-box">

            <div class="warning-title">
                ⚠ Confirm deletion
            </div>

            <div class="warning-text">
                This action will permanently remove this generated statement.
                The operation cannot be undone.
            </div>

        </div>


        <!-- CARD HEADER -->
        <div class="card-header-custom">

            <h2 class="card-title">
                Statement Information
            </h2>

            <span class="statement-code">
                @Model.StatementCode
            </span>

        </div>


        <!-- BODY -->
        <div class="delete-body">

            <!-- BASIC INFORMATION -->
            <div class="section-title">
                Basic Information
            </div>

            <div class="detail-grid">

                <div class="detail-item">

                    <span class="detail-label">
                        Release ID
                    </span>

                    <span class="detail-value">
                        #@Model.ReleaseId
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Statement Type
                    </span>

                    <span class="detail-value">
                        @Model.StatementType
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Audience
                    </span>

                    <span class="detail-value">
                        @Model.Audience
                    </span>

                </div>


                <div class="detail-item">

                    <span class="detail-label">
                        Impact Level
                    </span>

                    <span class="detail-value">
                        @Model.ImpactLevel
                    </span>

                </div>

            </div>


            <!-- STATEMENT -->
            <div class="mt-4">

                <div class="section-title">
                    Generated Statement
                </div>

                <div class="statement-content">
                    @Model.StatementText
                </div>

            </div>


            <!-- EVIDENCE -->
            <div class="mt-4">

                <div class="section-title">
                    Evidence References
                </div>

                <div class="evidence-content">

                    @if (!string.IsNullOrWhiteSpace(Model.EvidenceReferences))
                    {
                        @Model.EvidenceReferences
                    }
                    else
                    {
                        <span class="metadata">
                            No evidence references provided.
                        </span>
                    }

                </div>

            </div>


            <!-- STATUS -->
            <div class="mt-4">

                <div class="section-title">
                    Validation & Review
                </div>

                <div class="detail-grid">

                    <div class="detail-item">

                        <span class="detail-label">
                            Evidence Support
                        </span>

                        @if (Model.IsSupported)
                        {
                            <span class="badge badge-supported">
                                ✓ Supported
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-unsupported">
                                ✕ Unsupported
                            </span>
                        }

                    </div>


                    <div class="detail-item">

                        <span class="detail-label">
                            Freshness
                        </span>

                        @if (Model.IsStale)
                        {
                            <span class="badge badge-stale">
                                ⚠ Stale
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-current">
                                ✓ Current
                            </span>
                        }

                    </div>


                    <div class="detail-item">

                        <span class="detail-label">
                            Review Status
                        </span>

                        @if (Model.Status == "Approved")
                        {
                            <span class="badge badge-approved">
                                Approved
                            </span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="badge badge-rejected">
                                Rejected
                            </span>
                        }
                        else if (Model.Status == "Edited")
                        {
                            <span class="badge badge-edited">
                                Edited
                            </span>
                        }
                        else
                        {
                            <span class="badge badge-draft">
                                Draft
                            </span>
                        }

                    </div>


                    <div class="detail-item">

                        <span class="detail-label">
                            AI Model
                        </span>

                        <span class="detail-value">

                            @if (!string.IsNullOrWhiteSpace(Model.Aimodel))
                            {
                                @Model.Aimodel
                            }
                            else
                            {
                                <span class="metadata">
                                    Not specified
                                </span>
                            }

                        </span>

                    </div>

                </div>

            </div>


            <!-- METADATA -->
            <div class="mt-4">

                <div class="section-title">
                    Record Information
                </div>

                <div class="detail-grid">

                    <div class="detail-item">

                        <span class="detail-label">
                            Created At
                        </span>

                        <span class="metadata">
                            @Model.CreatedAt
                        </span>

                    </div>

                    <div class="detail-item">

                        <span class="detail-label">
                            Updated At
                        </span>

                        <span class="metadata">
                            @Model.UpdatedAt
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- FOOTER -->
        <div class="delete-footer">

            <a asp-action="Index"
               class="btn-cancel">
                ← Cancel
            </a>

            <div class="delete-actions">

                <a asp-action="Details"
                   asp-route-id="@Model.GeneratedStatementId"
                   class="btn-cancel">
                    View Details
                </a>

                <form asp-action="Delete"
                      method="post"
                      style="display:inline;">

                    <input type="hidden"
                           asp-for="GeneratedStatementId" />

                    <button type="submit"
                            class="btn-delete">
                        Delete Statement
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>