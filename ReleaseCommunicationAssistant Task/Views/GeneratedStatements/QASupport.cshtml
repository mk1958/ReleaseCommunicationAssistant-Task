@model ReleaseCommunicationAssistant_Task.Models.QASupportViewModel

@{
    ViewData["Title"] = "QA Claim Support Analysis";
}

<style>
    .qa-page {
        color: #e5e7eb;
    }

    .qa-title {
        color: #f8fafc;
        font-weight: 700;
    }

    .qa-subtitle {
        color: #94a3b8;
    }

    .qa-card {
        background: #111827;
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 12px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .qa-card-header {
        background: #151e2e;
        color: #f8fafc;
        padding: 15px 20px;
        border-bottom: 1px solid rgba(148, 163, 184, 0.14);
    }

    .qa-card-body {
        padding: 20px;
    }

    .statement-box {
        background: #0b1220;
        border: 1px solid rgba(148, 163, 184, 0.15);
        border-radius: 8px;
        padding: 16px;
        color: #dbe4ef;
        line-height: 1.6;
    }

    .supported {
        background: rgba(16, 185, 129, 0.12);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.25);
        padding: 7px 12px;
        border-radius: 7px;
        font-weight: 700;
    }

    .unsupported {
        background: rgba(239, 68, 68, 0.12);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.25);
        padding: 7px 12px;
        border-radius: 7px;
        font-weight: 700;
    }

    .evidence-item {
        background: #0b1220;
        border: 1px solid rgba(148, 163, 184, 0.13);
        border-radius: 8px;
        padding: 15px;
        margin-bottom: 10px;
    }

    .evidence-code {
        color: #60a5fa;
        font-weight: 700;
    }

    .evidence-description {
        color: #cbd5e1;
        margin-top: 6px;
    }

    .reason {
        color: #cbd5e1;
        line-height: 1.6;
    }

    .back-btn {
        background: rgba(148, 163, 184, 0.08);
        color: #cbd5e1;
        border: 1px solid rgba(148, 163, 184, 0.20);
        padding: 9px 16px;
        border-radius: 8px;
        text-decoration: none;
    }

        .back-btn:hover {
            background: rgba(148, 163, 184, 0.15);
            color: #fff;
        }
</style>

<div class="container mt-4 qa-page">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="qa-title">
                QA Claim Support Analysis
            </h2>

            <p class="qa-subtitle mb-0">
                Release @Model.VersionNumber
                · Statement @Model.StatementCode
            </p>
        </div>

        <a asp-action="Index" class="back-btn">
            ← Back to Statements
        </a>
    </div>

    <!-- Statement -->
    <div class="qa-card">
        <div class="qa-card-header">
            <strong>Generated Statement</strong>
        </div>

        <div class="qa-card-body">
            <div class="statement-box">
                @Model.StatementText
            </div>
        </div>
    </div>

    <!-- Analysis -->
    <div class="qa-card">
        <div class="qa-card-header">
            <strong>QA Support Result</strong>
        </div>

        <div class="qa-card-body">

            @if (Model.IsSupported)
            {
                <span class="supported">
                    ✓ Supported
                </span>
            }
            else
            {
                <span class="unsupported">
                    ⚠ Unsupported
                </span>
            }

            <p class="reason mt-3 mb-0">
                @Model.AnalysisReason
            </p>

        </div>
    </div>

    <!-- Evidence References -->
    <div class="qa-card">
        <div class="qa-card-header">
            <strong>Statement Evidence References</strong>
        </div>

        <div class="qa-card-body">

            @if (string.IsNullOrWhiteSpace(Model.EvidenceReferences))
            {
                <span class="text-muted">
                    No evidence references supplied.
                </span>
            }
            else
            {
                <div class="statement-box">
                    @Model.EvidenceReferences
                </div>
            }

        </div>
    </div>

    <!-- Supporting QA Evidence -->
    <div class="qa-card">
        <div class="qa-card-header">
            <strong>Matching QA Evidence</strong>
        </div>

        <div class="qa-card-body">

            @if (!Model.SupportingEvidence.Any())
            {
                <div class="reason">
                    No matching QA evidence was found.
                </div>
            }
            else
            {
                @foreach (var evidence in Model.SupportingEvidence)
                {
                    <div class="evidence-item">

                        <div>
                            <span class="evidence-code">
                                @evidence.EvidenceCode
                            </span>
                            -
                            @evidence.TestArea
                        </div>

                        <div class="mt-2">
                            <strong>Result:</strong>
                            @evidence.Result
                        </div>

                        <div class="evidence-description">
                            @evidence.EvidenceDescription
                        </div>

                    </div>
                }
            }

        </div>
    </div>

    <!-- Unsupported Claims -->
    @if (Model.UnsupportedClaims.Any())
    {
        <div class="qa-card">
            <div class="qa-card-header">
                <strong>Unsupported Claims / Issues</strong>
            </div>

            <div class="qa-card-body">

                @foreach (var claim in Model.UnsupportedClaims)
                {
                    <div class="reason mb-2">
                        ⚠ @claim
                    </div>
                }

            </div>
        </div>
    }

</div>