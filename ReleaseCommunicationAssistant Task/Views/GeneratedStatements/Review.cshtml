@model ReleaseCommunicationAssistant_Task.Models.ReviewStatementViewModel

@{
    ViewData["Title"] = "Review Generated Statement";
}

<style>
    .review-page {
        color: #e5e7eb;
        padding-bottom: 40px;
    }

        .review-page h2 {
            color: #f8fafc;
            font-weight: 700;
            margin-bottom: 6px;
        }

    .review-subtitle {
        color: #94a3b8;
        margin-bottom: 0;
    }

    .review-card {
        background: #111827;
        border: 1px solid #1f2937;
        border-radius: 12px;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.25);
        overflow: hidden;
    }

    .review-card-header {
        background: #151f2e;
        color: #f8fafc;
        border-bottom: 1px solid #263244;
        padding: 16px 20px;
        font-size: 16px;
        font-weight: 600;
    }

    .review-card-body {
        padding: 22px;
    }

    .review-label {
        color: #94a3b8;
        font-size: 13px;
        margin-bottom: 6px;
        text-transform: uppercase;
        letter-spacing: .3px;
    }

    .review-value {
        color: #f8fafc;
        font-size: 15px;
        font-weight: 500;
    }

    .review-form-label {
        color: #e5e7eb;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .review-input {
        background: #0b1220 !important;
        color: #f8fafc !important;
        border: 1px solid #334155 !important;
        border-radius: 8px !important;
        padding: 12px 14px;
    }

        .review-input:focus {
            background: #0b1220 !important;
            color: #ffffff !important;
            border-color: #3b82f6 !important;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, .15) !important;
        }

        .review-input::placeholder {
            color: #64748b !important;
        }

    textarea.review-input {
        resize: vertical;
    }

    .review-help {
        color: #64748b;
        font-size: 13px;
        margin-top: 6px;
    }

    .evidence-badge {
        display: inline-block;
        background: rgba(6, 182, 212, .12);
        color: #22d3ee;
        border: 1px solid rgba(6, 182, 212, .25);
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-supported {
        display: inline-block;
        background: rgba(34, 197, 94, .12);
        color: #4ade80;
        border: 1px solid rgba(34, 197, 94, .25);
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-unsupported {
        display: inline-block;
        background: rgba(239, 68, 68, .12);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, .25);
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-draft {
        display: inline-block;
        background: rgba(59, 130, 246, .12);
        color: #60a5fa;
        border: 1px solid rgba(59, 130, 246, .25);
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
    }

    .status-stale {
        display: inline-block;
        background: rgba(245, 158, 11, .12);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, .25);
        padding: 6px 10px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
    }

    .statement-preview {
        background: #0b1220;
        border: 1px solid #263244;
        border-radius: 8px;
        padding: 15px;
        color: #dbeafe;
        line-height: 1.7;
        white-space: pre-wrap;
    }

    .review-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 24px;
    }

    .review-btn {
        border-radius: 8px;
        padding: 10px 20px;
        font-weight: 600;
        border: 1px solid transparent;
        transition: all .2s ease;
    }

        .review-btn:hover {
            transform: translateY(-1px);
        }

    .btn-approve {
        background: rgba(34, 197, 94, .12);
        color: #4ade80;
        border-color: rgba(34, 197, 94, .3);
    }

        .btn-approve:hover {
            background: rgba(34, 197, 94, .2);
            color: #86efac;
        }

    .btn-edit {
        background: rgba(59, 130, 246, .12);
        color: #60a5fa;
        border-color: rgba(59, 130, 246, .3);
    }

        .btn-edit:hover {
            background: rgba(59, 130, 246, .2);
            color: #93c5fd;
        }

    .btn-reject {
        background: rgba(239, 68, 68, .12);
        color: #f87171;
        border-color: rgba(239, 68, 68, .3);
    }

        .btn-reject:hover {
            background: rgba(239, 68, 68, .2);
            color: #fca5a5;
        }

    .btn-back {
        background: transparent;
        color: #94a3b8;
        border: 1px solid #334155;
        border-radius: 8px;
        padding: 9px 16px;
        text-decoration: none;
    }

        .btn-back:hover {
            background: #111827;
            color: #f8fafc;
            border-color: #475569;
        }

    .section-spacing {
        margin-bottom: 20px;
    }

    .warning-box {
        background: rgba(245, 158, 11, .08);
        border: 1px solid rgba(245, 158, 11, .25);
        color: #fbbf24;
        border-radius: 8px;
        padding: 12px 15px;
        margin-top: 15px;
    }
</style>

<div class="container mt-4 review-page">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Review Generated Statement</h2>

            <p class="review-subtitle">
                Review, edit, approve, or reject the generated release statement.
            </p>
        </div>

        <a asp-action="Index" class="btn-back">
            ← Back
        </a>

    </div>


    <!-- Release Information -->
    <div class="review-card section-spacing">

        <div class="review-card-header">
            Release Information
        </div>

        <div class="review-card-body">

            <div class="row">

                <div class="col-md-3 mb-3 mb-md-0">

                    <div class="review-label">
                        Version
                    </div>

                    <div class="review-value">
                        @Model.VersionNumber
                    </div>

                </div>


                <div class="col-md-3 mb-3 mb-md-0">

                    <div class="review-label">
                        Audience
                    </div>

                    <div class="review-value">
                        @Model.Audience
                    </div>

                </div>


                <div class="col-md-3 mb-3 mb-md-0">

                    <div class="review-label">
                        Statement Type
                    </div>

                    <div class="review-value">
                        @Model.StatementType
                    </div>

                </div>


                <div class="col-md-3">

                    <div class="review-label">
                        Impact Level
                    </div>

                    <div class="review-value">
                        @Model.ImpactLevel
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Evidence & Validation -->
    <div class="review-card section-spacing">

        <div class="review-card-header">
            Evidence & Validation
        </div>

        <div class="review-card-body">

            <div class="mb-4">

                <div class="review-label">
                    Evidence References
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.EvidenceReferences))
                {
                    <span class="evidence-badge">
                        @Model.EvidenceReferences
                    </span>
                }
                else
                {
                    <span class="review-subtitle">
                        No evidence references supplied.
                    </span>
                }

            </div>


            <div class="mb-3">

                <div class="review-label">
                    Evidence Support
                </div>

                @if (Model.IsSupported)
                {
                    <span class="status-supported">
                        ✓ Supported
                    </span>
                }
                else
                {
                    <span class="status-unsupported">
                        ⚠ Unsupported
                    </span>
                }

            </div>


            <div>

                <div class="review-label">
                    Statement Status
                </div>

                @if (Model.IsStale)
                {
                    <span class="status-stale">
                        ⚠ Stale
                    </span>

                    <div class="warning-box">
                        <strong>Stale Statement</strong>
                        <br />

                        This statement should be reviewed because the
                        underlying release information may have changed.

                        @if (!string.IsNullOrWhiteSpace(Model.StaleReason))
                        {
                            <div class="mt-2">
                                <strong>Reason:</strong>
                                @Model.StaleReason
                            </div>
                        }
                    </div>
                }
                else
                {
                    <span class="status-draft">
                        @Model.Status
                    </span>
                }

            </div>


            @if (!Model.IsSupported)
            {
                <div class="warning-box">
                    ⚠ This statement is not currently supported by the supplied evidence.
                    Review the statement carefully before approving it.
                </div>
            }

        </div>

    </div>


    <!-- Review Form -->
    <form asp-action="Review" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="GeneratedStatementId" />

        <input type="hidden"
               asp-for="ReleaseId" />


        <!-- Generated Statement -->
        <div class="review-card section-spacing">

            <div class="review-card-header">
                Generated Statement
            </div>

            <div class="review-card-body">

                <!-- Original -->
                <div class="mb-4">

                    <label class="review-form-label">
                        Original Generated Content
                    </label>

                    <div class="statement-preview">
                        @Model.StatementText
                    </div>

                </div>


                <!-- Edited -->
                <div>

                    <label asp-for="EditedText"
                           class="review-form-label">
                        Edited Content
                    </label>

                    <textarea asp-for="EditedText"
                              class="form-control review-input"
                              rows="7"
                              placeholder="Edit the generated statement if required..."></textarea>

                    <div class="review-help">
                        Leave this empty to keep the original generated content.
                    </div>

                </div>

            </div>

        </div>


        <!-- Reviewer Information -->
        <div class="review-card section-spacing">

            <div class="review-card-header">
                Reviewer Decision
            </div>

            <div class="review-card-body">

                <!-- Reviewer Name -->
                <div class="mb-4">

                    <label asp-for="ReviewerName"
                           class="review-form-label">
                        Reviewer Name
                    </label>

                    <input asp-for="ReviewerName"
                           class="form-control review-input"
                           placeholder="Enter reviewer name" />

                </div>


                <!-- Review Comment -->
                <div>

                    <label asp-for="ReviewComment"
                           class="review-form-label">
                        Review Comment
                    </label>

                    <textarea asp-for="ReviewComment"
                              class="form-control review-input"
                              rows="4"
                              placeholder="Add review comments..."></textarea>

                </div>

            </div>

        </div>


        <!-- Action Buttons -->
        <div class="review-actions">

            <button type="submit"
                    name="decision"
                    value="Approve"
                    class="review-btn btn-approve">
                ✓ Approve
            </button>


            <button type="submit"
                    name="decision"
                    value="Edit"
                    class="review-btn btn-edit">
                ✎ Save Edit
            </button>


            <button type="submit"
                    name="decision"
                    value="Reject"
                    class="review-btn btn-reject">
                ✕ Reject
            </button>


            <a asp-action="Index"
               class="btn-back">
                Cancel
            </a>

        </div>

    </form>

</div>