@model ReleaseCommunicationAssistant_Task.Models.GeneratedStatements

@{
    ViewData["Title"] = "Create Generated Statement";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        background: radial-gradient(circle at 10% 20%, rgba(37, 99, 235, 0.18), transparent 30%), radial-gradient(circle at 90% 80%, rgba(124, 58, 237, 0.18), transparent 30%), linear-gradient(135deg, #020617, #0f172a 50%, #172554);
        min-height: 100vh;
    }

    .create-page {
        position: relative;
        min-height: calc(100vh - 70px);
        padding: 40px 30px;
        overflow: hidden;
    }

    .orb {
        position: absolute;
        border-radius: 50%;
        filter: blur(2px);
        opacity: .35;
        pointer-events: none;
        animation: floatOrb 8s ease-in-out infinite;
    }

    .orb-one {
        width: 180px;
        height: 180px;
        background: #2563eb;
        top: 40px;
        left: -60px;
    }

    .orb-two {
        width: 230px;
        height: 230px;
        background: #7c3aed;
        right: -90px;
        top: 35%;
        animation-delay: 2s;
    }

    .orb-three {
        width: 130px;
        height: 130px;
        background: #06b6d4;
        bottom: 20px;
        left: 35%;
        animation-delay: 4s;
    }

    @@keyframes floatOrb {
        0%, 100% {
            transform: translate3d(0, 0, 0) scale(1);
        }

        50% {
            transform: translate3d(0, -25px, 0) scale(1.08);
        }
    }

    .create-wrapper {
        position: relative;
        z-index: 2;
        max-width: 1100px;
        margin: auto;
        perspective: 1200px;
    }

    .create-header {
        color: white;
        margin-bottom: 25px;
        animation: slideDown .7s ease;
    }

        .create-header h1 {
            font-size: 32px;
            font-weight: 800;
            margin: 0;
            letter-spacing: -.5px;
        }

        .create-header p {
            color: #cbd5e1;
            margin-top: 8px;
            font-size: 14px;
        }

    .header-badge {
        display: inline-block;
        background: rgba(59, 130, 246, .15);
        border: 1px solid rgba(96, 165, 250, .35);
        color: #93c5fd;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 12px;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .create-card {
        background: rgba(255, 255, 255, .94);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        border: 1px solid rgba(255, 255, 255, .7);
        border-radius: 22px;
        box-shadow: 0 25px 60px rgba(0, 0, 0, .30), 0 8px 20px rgba(0, 0, 0, .10);
        overflow: hidden;
        transform: translateZ(0);
        animation: cardEnter .8s cubic-bezier(.2, .8, .2, 1);
        transition: transform .35s ease, box-shadow .35s ease;
    }

        .create-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 35px 80px rgba(0, 0, 0, .35), 0 12px 25px rgba(37, 99, 235, .10);
        }

    @@keyframes cardEnter {
        from {
            opacity: 0;
            transform: perspective(1200px) rotateX(5deg) translateY(25px);
        }

        to {
            opacity: 1;
            transform: perspective(1200px) rotateX(0) translateY(0);
        }
    }

    .card-top {
        position: relative;
        padding: 25px 32px;
        background: linear-gradient(135deg, #eff6ff, #eef2ff);
        border-bottom: 1px solid #dbeafe;
    }

        .card-top h2 {
            margin: 0;
            font-size: 19px;
            color: #0f172a;
            font-weight: 750;
        }

        .card-top p {
            margin: 5px 0 0;
            color: #64748b;
            font-size: 12px;
        }

    .floating-icon {
        position: absolute;
        right: 35px;
        top: 25px;
        width: 55px;
        height: 55px;
        border-radius: 15px;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 24px;
        box-shadow: 0 12px 25px rgba(37, 99, 235, .30);
        animation: floatingIcon 4s ease-in-out infinite;
    }

    @@keyframes floatingIcon {
        0%, 100% {
            transform: translateY(0) rotate(0deg);
        }

        50% {
            transform: translateY(-8px) rotate(3deg);
        }
    }

    .form-body {
        padding: 32px;
    }

    .form-section {
        margin-bottom: 30px;
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
    }

    .section-number {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: white;
        font-size: 12px;
        font-weight: 800;
        box-shadow: 0 5px 12px rgba(37, 99, 235, .25);
    }

    .section-heading h3 {
        margin: 0;
        font-size: 15px;
        color: #0f172a;
        font-weight: 750;
    }

    .section-heading span {
        color: #64748b;
        font-size: 11px;
        margin-left: 4px;
    }

    .form-label {
        color: #334155;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        border: 1px solid #cbd5e1;
        border-radius: 9px;
        padding: 11px 13px;
        color: #0f172a;
        background: #ffffff;
        font-size: 13px;
        transition: all .2s ease;
    }

        .form-control:hover,
        .form-select:hover {
            border-color: #94a3b8;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .10), 0 5px 15px rgba(37, 99, 235, .08);
            outline: none;
        }

    textarea.form-control {
        resize: vertical;
        min-height: 120px;
        line-height: 1.6;
    }

    .status-card {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        height: 100%;
        transition: .2s ease;
    }

        .status-card:hover {
            border-color: #93c5fd;
            background: #f8fbff;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(15, 23, 42, .06);
        }

        .status-card .form-check {
            display: flex;
            align-items: center;
            gap: 9px;
            margin: 0;
        }

    .form-check-input {
        width: 18px;
        height: 18px;
        margin: 0;
        cursor: pointer;
    }

        .form-check-input:checked {
            background-color: #2563eb;
            border-color: #2563eb;
        }

    .form-check-label {
        font-size: 13px;
        font-weight: 700;
        color: #334155;
        cursor: pointer;
    }

    .help-text {
        color: #64748b;
        font-size: 10px;
        line-height: 1.5;
        margin-top: 8px;
    }

    .text-danger {
        display: block;
        margin-top: 5px;
        color: #dc2626;
        font-size: 11px;
    }

    .validation-summary-errors {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-left: 4px solid #ef4444;
        border-radius: 9px;
        color: #991b1b;
        padding: 13px 16px;
        margin-bottom: 25px;
        font-size: 12px;
    }

        .validation-summary-errors ul {
            padding-left: 20px;
        }

    .form-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        border-top: 1px solid #e2e8f0;
        padding-top: 25px;
        margin-top: 10px;
    }

    .btn-create {
        border: none;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: white;
        padding: 11px 25px;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(37, 99, 235, .25);
        transition: all .25s ease;
    }

        .btn-create:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(37, 99, 235, .35);
            color: white;
        }

    .btn-back {
        color: #475569;
        background: #f8fafc;
        border: 1px solid #cbd5e1;
        padding: 10px 18px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .2s;
    }

        .btn-back:hover {
            background: #f1f5f9;
            color: #0f172a;
        }

    @@media (max-width: 768px) {

        .create-page {
            padding: 20px 15px;
        }

        .form-body {
            padding: 20px;
        }

        .card-top {
            padding: 20px;
        }

        .create-header h1 {
            font-size: 25px;
        }

        .floating-icon {
            display: none;
        }

        .form-footer {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .btn-create,
        .btn-back {
            width: 100%;
            text-align: center;
        }
    }
</style>

<div class="create-page">

    <div class="orb orb-one"></div>
    <div class="orb orb-two"></div>
    <div class="orb orb-three"></div>

    <div class="create-wrapper">

        <div class="create-header">

            <span class="header-badge">
                Release Communication Assistant
            </span>

            <h1>
                Create Generated Statement
            </h1>

            <p>
                Create and configure a release communication statement for review.
            </p>

        </div>

        <div class="create-card">

            <div class="card-top">

                <div class="floating-icon">
                    ✦
                </div>

                <h2>
                    New Release Statement
                </h2>

                <p>
                    Provide the release details, statement content, evidence and validation information.
                </p>

            </div>

            <div class="form-body">

                <form asp-action="Create" method="post">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="validation-summary-errors">

                            <strong>
                                Please fix the following errors:
                            </strong>

                            <ul class="mb-0 mt-2">

                                @foreach (var entry in ViewData.ModelState)
                                {
                                    foreach (var error in entry.Value.Errors)
                                    {
                                        <li>
                                            @(string.IsNullOrWhiteSpace(error.ErrorMessage)
                                                                            ? $"Invalid value for {entry.Key}"
                                                                            : error.ErrorMessage)
                            </li>
                                                        }
                                }

                            </ul>

                        </div>
                    }

                    <!-- SECTION 1 -->

                    <div class="form-section">

                        <div class="section-heading">

                            <div class="section-number">
                                01
                            </div>

                            <div>
                                <h3>
                                    Statement Information
                                </h3>

                                <span>
                                    Basic release details
                                </span>
                            </div>

                        </div>

                        <div class="row g-4">

                            <!-- RELEASE -->

                            <div class="col-md-4">

                                <label asp-for="ReleaseId"
                                       class="form-label">
                                    Release
                                </label>

                                <select id="ReleaseId"
                                        name="ReleaseId"
                                        class="form-select"
                                        required>

                                    <option value="">
                                        Select Release
                                    </option>

                                    @if (ViewBag.Releases != null)
                                    {
                                        foreach (var release in ViewBag.Releases)
                                        {
                                            <option value="@release.ReleaseId">
                                                Release @release.VersionNumber (ID: @release.ReleaseId)
                                            </option>
                                        }
                                    }

                                </select>

                                <span asp-validation-for="ReleaseId"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- STATEMENT CODE -->

                            <div class="col-md-4">

                                <label asp-for="StatementCode"
                                       class="form-label">
                                    Statement Code
                                </label>

                                <input asp-for="StatementCode"
                                       class="form-control"
                                       placeholder="Example: STMT-001" />

                                <span asp-validation-for="StatementCode"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- AUDIENCE -->

                            <div class="col-md-4">

                                <label asp-for="Audience"
                                       class="form-label">
                                    Audience
                                </label>

                                <select asp-for="Audience"
                                        class="form-select">

                                    <option value="">
                                        Select Audience
                                    </option>

                                    <option value="Technical">
                                        Technical
                                    </option>

                                    <option value="Stakeholder">
                                        Stakeholder
                                    </option>

                                </select>

                                <span asp-validation-for="Audience"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- STATEMENT TYPE -->

                            <div class="col-md-6">

                                <label asp-for="StatementType"
                                       class="form-label">
                                    Statement Type
                                </label>

                                <input asp-for="StatementType"
                                       class="form-control"
                                       placeholder="Example: Feature, Bug Fix, Risk" />

                                <span asp-validation-for="StatementType"
                                      class="text-danger">
                                </span>

                            </div>

                            <!-- IMPACT LEVEL -->

                            <div class="col-md-6">

                                <label asp-for="ImpactLevel"
                                       class="form-label">
                                    Impact Level
                                </label>

                                <select asp-for="ImpactLevel"
                                        class="form-select">

                                    <option value="">
                                        Select Impact Level
                                    </option>

                                    <option value="Low">
                                        Low
                                    </option>

                                    <option value="Medium">
                                        Medium
                                    </option>

                                    <option value="High">
                                        High
                                    </option>

                                </select>

                                <span asp-validation-for="ImpactLevel"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                    <!-- SECTION 2 -->

                    <div class="form-section">

                        <div class="section-heading">

                            <div class="section-number">
                                02
                            </div>

                            <div>
                                <h3>
                                    Statement Content
                                </h3>

                                <span>
                                    Communication and evidence
                                </span>
                            </div>

                        </div>

                        <div class="mb-4">

                            <label asp-for="StatementText"
                                   class="form-label">
                                Statement Text
                            </label>

                            <textarea asp-for="StatementText"
                                      class="form-control"
                                      rows="6"
                                      placeholder="Enter the release communication statement..."></textarea>

                            <span asp-validation-for="StatementText"
                                  class="text-danger">
                            </span>

                        </div>

                        <div>

                            <label asp-for="EvidenceReferences"
                                   class="form-label">
                                Evidence References
                            </label>

                            <textarea asp-for="EvidenceReferences"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Example: QA-001, QA-002, RELEASE-001"></textarea>

                            <div class="help-text">
                                Add the release item or QA evidence references supporting this statement.
                            </div>

                            <span asp-validation-for="EvidenceReferences"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <!-- SECTION 3 -->

                    <div class="form-section">

                        <div class="section-heading">

                            <div class="section-number">
                                03
                            </div>

                            <div>
                                <h3>
                                    Validation & Review
                                </h3>

                                <span>
                                    Evidence and statement status
                                </span>
                            </div>

                        </div>

                        <div class="row g-4">

                            <!-- SUPPORTED -->

                            <div class="col-md-4">

                                <div class="status-card">

                                    <div class="form-check">

                                        <input asp-for="IsSupported"
                                               class="form-check-input" />

                                        <label asp-for="IsSupported"
                                               class="form-check-label">
                                            Evidence Supported
                                        </label>

                                    </div>

                                    <div class="help-text">
                                        Indicates whether the statement is supported by supplied evidence.
                                    </div>

                                </div>

                            </div>

                            <!-- STALE -->

                            <div class="col-md-4">

                                <div class="status-card">

                                    <div class="form-check">

                                        <input asp-for="IsStale"
                                               class="form-check-input" />

                                        <label asp-for="IsStale"
                                               class="form-check-label">
                                            Statement Is Stale
                                        </label>

                                    </div>

                                    <div class="help-text">
                                        Mark this if the release package changed after the statement was generated.
                                    </div>

                                </div>

                            </div>

                            <!-- STATUS -->

                            <div class="col-md-4">

                                <div class="status-card">

                                    <label asp-for="Status"
                                           class="form-label">
                                        Review Status
                                    </label>

                                    <select asp-for="Status"
                                            class="form-select">

                                        <option value="Draft">
                                            Draft
                                        </option>

                                        <option value="Edited">
                                            Edited
                                        </option>

                                        <option value="Approved">
                                            Approved
                                        </option>

                                        <option value="Rejected">
                                            Rejected
                                        </option>

                                    </select>

                                    <span asp-validation-for="Status"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>

                        <!-- STALE REASON -->

                        <div class="mt-4">

                            <label asp-for="StaleReason"
                                   class="form-label">
                                Stale Reason
                            </label>

                            <textarea asp-for="StaleReason"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Explain why the statement is stale, if applicable..."></textarea>

                            <span asp-validation-for="StaleReason"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                    <!-- SECTION 4 -->

                    <div class="form-section">

                        <div class="section-heading">

                            <div class="section-number">
                                04
                            </div>

                            <div>
                                <h3>
                                    AI Information
                                </h3>

                                <span>
                                    Generation metadata
                                </span>
                            </div>

                        </div>

                        <div class="row">

                            <div class="col-md-6">

                                <label asp-for="Aimodel"
                                       class="form-label">
                                    AI Model
                                </label>

                                <input asp-for="Aimodel"
                                       class="form-control"
                                       placeholder="Example: openai/gpt-oss-20b" />

                                <span asp-validation-for="Aimodel"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                    <!-- FOOTER -->

                    <div class="form-footer">

                        <a asp-action="Index"
                           class="btn-back">
                            ← Back to Statements
                        </a>

                        <button type="submit"
                                class="btn-create">
                            ✦ Create Statement
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}