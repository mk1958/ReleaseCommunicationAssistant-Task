@model ReleaseCommunicationAssistant_Task.Models.ReviewDecision

@{
    ViewData["Title"] = "Review Decision Details";
}

<style>
    body {
        background: #0b1020;
        color: #e5e7eb;
    }

    .page-wrapper {
        max-width: 1000px;
        margin: 50px auto;
        padding: 20px;
    }

    .details-card {
        background: #111827;
        border: 1px solid #26324a;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,.35);
    }

    .header {
        background: linear-gradient(135deg,#1d4ed8,#6d28d9);
        padding: 30px;
    }

        .header h1 {
            margin: 0;
            font-size: 30px;
            font-weight: 700;
            color: white;
        }

        .header p {
            margin: 8px 0 0;
            color: rgba(255,255,255,.75);
        }

    .content {
        padding: 35px;
    }

    .section-title {
        color: #60a5fa;
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 20px;
    }

    .info-box {
        background: #0f172a;
        border: 1px solid #26324a;
        border-radius: 12px;
        padding: 18px;
    }

    .info-label {
        color: #64748b;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: .5px;
        margin-bottom: 7px;
    }

    .info-value {
        color: #f8fafc;
        font-size: 16px;
        font-weight: 600;
        word-break: break-word;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .text-content {
        color: #cbd5e1;
        line-height: 1.7;
        font-weight: 400;
        white-space: pre-wrap;
    }

    .decision {
        display: inline-block;
        padding: 7px 14px;
        border-radius: 20px;
        background: rgba(34,197,94,.12);
        color: #4ade80;
        font-size: 13px;
        font-weight: 700;
    }

    .actions {
        margin-top: 30px;
        display: flex;
        gap: 12px;
    }

    .btn-edit {
        background: linear-gradient(135deg,#2563eb,#7c3aed);
        color: white;
        border: none;
        border-radius: 9px;
        padding: 10px 20px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-edit:hover {
            color: white;
            opacity: .9;
        }

    .btn-back {
        background: #1e293b;
        border: 1px solid #334155;
        color: #cbd5e1;
        border-radius: 9px;
        padding: 10px 20px;
        text-decoration: none;
    }

        .btn-back:hover {
            color: white;
            border-color: #60a5fa;
        }

    @@media(max-width:700px) {
        .info-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }
    }
</style>

<div class="page-wrapper">

    <div class="details-card">

        <div class="header">
            <h1>Review Decision Details</h1>
            <p>Human review record for an AI-generated release statement</p>
        </div>

        <div class="content">

            <div class="section-title">
                Review Information
            </div>

            <div class="info-grid">

                <!-- Review ID -->
                <div class="info-box">
                    <div class="info-label">
                        Review Decision ID
                    </div>

                    <div class="info-value">
                        #@Model.ReviewDecisionId
                    </div>
                </div>

                <!-- Generated Statement -->
                <div class="info-box">
                    <div class="info-label">
                        Generated Statement ID
                    </div>

                    <div class="info-value">
                        #@Model.GeneratedStatementId
                    </div>
                </div>

                <!-- Decision -->
                <div class="info-box">
                    <div class="info-label">
                        Decision
                    </div>

                    <div>
                        <span class="decision">
                            @Model.Decision
                        </span>
                    </div>
                </div>

                <!-- Reviewer -->
                <div class="info-box">
                    <div class="info-label">
                        Reviewer
                    </div>

                    <div class="info-value">
                        @Model.ReviewerName
                    </div>
                </div>

                <!-- Edited Text -->
                <div class="info-box full-width">

                    <div class="info-label">
                        Reviewed / Edited Text
                    </div>

                    <div class="text-content">
                        @(string.IsNullOrWhiteSpace(Model.EditedText)
                                                ? "No edited text provided."
                                                : Model.EditedText)
                    </div>

                </div>

                <!-- Review Comment -->
                <div class="info-box full-width">

                    <div class="info-label">
                        Review Comment
                    </div>

                    <div class="text-content">
                        @(string.IsNullOrWhiteSpace(Model.ReviewComment)
                                                ? "No review comment provided."
                                                : Model.ReviewComment)
                    </div>

                </div>

                <!-- Reviewed At -->
                <div class="info-box">

                    <div class="info-label">
                        Reviewed At
                    </div>

                    <div class="info-value">
                        @Model.ReviewedAt.ToString("dd MMM yyyy, HH:mm")
                    </div>

                </div>

            </div>

            <div class="actions">

                <a asp-action="Edit"
                   asp-route-id="@Model.ReviewDecisionId"
                   class="btn-edit">
                    Edit Decision
                </a>

                <a asp-action="Index"
                   class="btn-back">
                    ← Back to List
                </a>

            </div>

        </div>

    </div>

</div>