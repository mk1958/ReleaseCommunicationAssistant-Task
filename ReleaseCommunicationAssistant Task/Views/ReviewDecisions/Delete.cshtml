@model ReleaseCommunicationAssistant_Task.Models.ReviewDecision

@{
    ViewData["Title"] = "Delete Review Decision";
}

<style>
    body {
        background: #0b1020;
        color: #e5e7eb;
    }

    .page-wrapper {
        max-width: 800px;
        margin: 70px auto;
        padding: 20px;
    }

    .delete-card {
        background: #111827;
        border: 1px solid rgba(239,68,68,.3);
        border-radius: 18px;
        padding: 40px;
        box-shadow: 0 20px 50px rgba(0,0,0,.35);
    }

    .warning-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(239,68,68,.12);
        border: 1px solid rgba(239,68,68,.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        margin-bottom: 22px;
    }

    .page-title {
        font-size: 30px;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 10px;
    }

    .warning-text {
        color: #94a3b8;
        line-height: 1.6;
        margin-bottom: 30px;
    }

    .decision-summary {
        background: #0f172a;
        border: 1px solid #26324a;
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 30px;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        padding: 10px 0;
        border-bottom: 1px solid #1f2937;
    }

        .summary-row:last-child {
            border-bottom: none;
        }

    .summary-label {
        color: #64748b;
        font-size: 13px;
    }

    .summary-value {
        color: #e2e8f0;
        font-weight: 600;
        text-align: right;
    }

    .btn-delete {
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 9px;
        padding: 11px 22px;
        font-weight: 600;
    }

        .btn-delete:hover {
            background: #b91c1c;
            color: white;
        }

    .btn-cancel {
        color: #94a3b8;
        text-decoration: none;
        margin-left: 15px;
    }

        .btn-cancel:hover {
            color: #60a5fa;
        }

    @@media(max-width:600px) {
        .summary-row {
            flex-direction: column;
            gap: 4px;
        }

        .summary-value {
            text-align: left;
        }
    }
</style>

<div class="page-wrapper">

    <div class="delete-card">

        <div class="warning-icon">
            ⚠
        </div>

        <div class="page-title">
            Delete Review Decision?
        </div>

        <div class="warning-text">
            You are about to permanently delete this review decision.
            This action cannot be undone.
        </div>

        <div class="decision-summary">

            <div class="summary-row">

                <span class="summary-label">
                    Review Decision ID
                </span>

                <span class="summary-value">
                    #@Model.ReviewDecisionId
                </span>

            </div>

            <div class="summary-row">

                <span class="summary-label">
                    Generated Statement ID
                </span>

                <span class="summary-value">
                    #@Model.GeneratedStatementId
                </span>

            </div>

            <div class="summary-row">

                <span class="summary-label">
                    Decision
                </span>

                <span class="summary-value">
                    @Model.Decision
                </span>

            </div>

            <div class="summary-row">

                <span class="summary-label">
                    Reviewer
                </span>

                <span class="summary-value">
                    @Model.ReviewerName
                </span>

            </div>

            <div class="summary-row">

                <span class="summary-label">
                    Reviewed At
                </span>

                <span class="summary-value">
                    @Model.ReviewedAt.ToString("dd MMM yyyy, HH:mm")
                </span>

            </div>

        </div>

        <form asp-action="Delete" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.ReviewDecisionId" />

            <button type="submit"
                    class="btn btn-delete">
                Delete Review Decision
            </button>

            <a asp-action="Index"
               class="btn-cancel">
                Cancel
            </a>

        </form>

    </div>

</div>