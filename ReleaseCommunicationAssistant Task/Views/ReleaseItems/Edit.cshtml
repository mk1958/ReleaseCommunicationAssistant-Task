@model ReleaseCommunicationAssistant_Task.Models.ReleaseItem

@{
    ViewData["Title"] = "Edit Release Item";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        background: radial-gradient(circle at 10% 10%, rgba(14,165,233,.14), transparent 28%), radial-gradient(circle at 90% 20%, rgba(139,92,246,.14), transparent 30%), linear-gradient(135deg,#07111f,#0f172a 55%,#172554);
        min-height: 100vh;
    }

    .page {
        min-height: calc(100vh - 70px);
        padding: 35px;
    }

    .header {
        background: linear-gradient(135deg,#0f172a,#164e63,#312e81);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 22px;
        padding: 30px;
        color: white;
        margin-bottom: 25px;
        box-shadow: 0 20px 45px rgba(0,0,0,.25);
    }

    .badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: rgba(56,189,248,.12);
        border: 1px solid rgba(125,211,252,.25);
        color: #7dd3fc;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 12px;
    }

    .header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
    }

    .header p {
        margin: 8px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    .card {
        max-width: 1000px;
        margin: auto;
        background: rgba(15,23,42,.94);
        border: 1px solid rgba(148,163,184,.14);
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
    }

    .section {
        margin-bottom: 30px;
    }

    .section-title {
        color: #f8fafc;
        font-size: 17px;
        font-weight: 750;
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(148,163,184,.12);
    }

        .section-title span {
            color: #38bdf8;
            margin-right: 8px;
        }

    .form-group {
        margin-bottom: 18px;
    }

    label {
        display: block;
        color: #cbd5e1;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        width: 100%;
        padding: 11px 13px;
        border-radius: 9px;
        border: 1px solid #334155;
        background: #0f172a;
        color: #e2e8f0;
        font-size: 13px;
        outline: none;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56,189,248,.08);
        }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .readonly {
        background: #020617;
        color: #94a3b8;
    }

    .validation {
        color: #f87171;
        font-size: 11px;
        margin-top: 5px;
    }

    .button-row {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 20px;
        border-top: 1px solid rgba(148,163,184,.12);
    }

    .btn {
        border: none;
        border-radius: 9px;
        padding: 11px 19px;
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
        transition: .2s;
    }

    .btn-primary {
        background: linear-gradient(135deg,#0284c7,#4f46e5);
        color: white;
    }

    .btn-secondary {
        background: #1e293b;
        color: #cbd5e1;
        border: 1px solid #334155;
    }

    .btn-danger {
        background: rgba(239,68,68,.12);
        color: #f87171;
        border: 1px solid rgba(239,68,68,.2);
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    @@media (max-width: 700px) {
        .page {
            padding: 18px;
        }

        .card {
            padding: 20px;
        }

        .button-row {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>


<div class="page">

    <div class="header">

        <span class="badge">
            Release Management
        </span>

        <h1>
            Edit Release Item
        </h1>

        <p>
            Update release item details, impact information, and affected users.
        </p>

    </div>


    <div class="card">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="ReleaseItemId" />


            <div class="section">

                <div class="section-title">
                    <span>01</span>
                    Release Information
                </div>

                <div class="form-group">

                    <label asp-for="ReleaseItemId">
                        Release Item ID
                    </label>

                    <input asp-for="ReleaseItemId"
                           class="form-control readonly"
                           readonly />

                </div>


                <div class="form-group">

                    <label asp-for="ReleaseId">
                        Release ID
                    </label>

                    <input asp-for="ReleaseId"
                           class="form-control" />

                    <span asp-validation-for="ReleaseId"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="EvidenceCode">
                        Evidence Code
                    </label>

                    <input asp-for="EvidenceCode"
                           class="form-control" />

                    <span asp-validation-for="EvidenceCode"
                          class="validation">
                    </span>

                </div>

            </div>


            <div class="section">

                <div class="section-title">
                    <span>02</span>
                    Change Details
                </div>

                <div class="form-group">

                    <label asp-for="ItemType">
                        Item Type
                    </label>

                    <select asp-for="ItemType"
                            class="form-select">

                        <option value="Feature">
                            Feature
                        </option>

                        <option value="BugFix">
                            Bug Fix
                        </option>

                        <option value="ChangedBehaviour">
                            Changed Behaviour
                        </option>

                    </select>

                    <span asp-validation-for="ItemType"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="Title">
                        Title
                    </label>

                    <input asp-for="Title"
                           class="form-control" />

                    <span asp-validation-for="Title"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="Description">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"></textarea>

                    <span asp-validation-for="Description"
                          class="validation">
                    </span>

                </div>

            </div>


            <div class="section">

                <div class="section-title">
                    <span>03</span>
                    User Impact
                </div>

                <div class="form-group">

                    <label asp-for="UserImpact">
                        User Impact
                    </label>

                    <select asp-for="UserImpact"
                            class="form-select">

                        <option value="Low">
                            Low
                        </option>

                        <option value="Medium">
                            Medium
                        </option>

                        <option value="High">
                            High
                        </option>

                    </select>

                    <span asp-validation-for="UserImpact"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="ImpactReason">
                        Impact Reason
                    </label>

                    <textarea asp-for="ImpactReason"
                              class="form-control"></textarea>

                    <span asp-validation-for="ImpactReason"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="AffectedUsers">
                        Affected Users
                    </label>

                    <input asp-for="AffectedUsers"
                           class="form-control" />

                    <span asp-validation-for="AffectedUsers"
                          class="validation">
                    </span>

                </div>

            </div>


            <div class="button-row">

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

                <a asp-action="Details"
                   asp-route-id="@Model.ReleaseItemId"
                   class="btn btn-secondary">
                    Details
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}