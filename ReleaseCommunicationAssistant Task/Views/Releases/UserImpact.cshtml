@model ReleaseCommunicationAssistant_Task.Models.UserImpactViewModel

@{
    ViewData["Title"] = "User Impact Classification";
}

<style>
    .impact-page {
        color: #e5e7eb;
    }

    .impact-header {
        margin-bottom: 28px;
    }

    .impact-title {
        color: #f8fafc;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .impact-subtitle {
        color: #94a3b8;
        margin-bottom: 0;
    }

    .back-btn {
        background: rgba(148, 163, 184, 0.08);
        color: #cbd5e1;
        border: 1px solid rgba(148, 163, 184, 0.20);
        padding: 9px 16px;
        border-radius: 8px;
        text-decoration: none;
        transition: all 0.2s ease;
    }

        .back-btn:hover {
            background: rgba(148, 163, 184, 0.15);
            color: #ffffff;
            border-color: rgba(148, 163, 184, 0.35);
        }

    .impact-card {
        background: #111827;
        border: 1px solid rgba(148, 163, 184, 0.16);
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    }

    .impact-card-header {
        background: #151e2e;
        color: #f8fafc;
        padding: 16px 20px;
        border-bottom: 1px solid rgba(148, 163, 184, 0.14);
    }

    .impact-table {
        width: 100%;
        margin-bottom: 0;
        color: #e5e7eb;
        background: #111827;
    }

        .impact-table thead th {
            background: #182235;
            color: #cbd5e1;
            border-bottom: 1px solid rgba(148, 163, 184, 0.20);
            padding: 14px 16px;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

        .impact-table tbody td {
            background: #111827;
            color: #dbe4ef;
            border-bottom: 1px solid rgba(148, 163, 184, 0.10);
            padding: 16px;
            vertical-align: middle;
        }

        .impact-table tbody tr:hover td {
            background: #172033;
        }

        .impact-table tbody tr:last-child td {
            border-bottom: none;
        }

    .evidence-badge {
        display: inline-block;
        background: rgba(148, 163, 184, 0.16);
        color: #cbd5e1;
        border: 1px solid rgba(148, 163, 184, 0.20);
        border-radius: 6px;
        padding: 4px 8px;
        font-size: 12px;
        font-weight: 600;
    }

    .release-title {
        color: #f1f5f9;
        font-weight: 600;
    }

    .reason-text {
        color: #cbd5e1;
        line-height: 1.5;
    }

    .affected-users {
        color: #cbd5e1;
        line-height: 1.5;
    }

    .not-specified {
        color: #64748b;
        font-style: italic;
    }

    .impact-badge {
        display: inline-block;
        min-width: 64px;
        text-align: center;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 700;
    }

    .impact-high {
        background: rgba(239, 68, 68, 0.14);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.25);
    }

    .impact-medium {
        background: rgba(245, 158, 11, 0.14);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.25);
    }

    .impact-low {
        background: rgba(16, 185, 129, 0.14);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.25);
    }

    .empty-impact {
        background: #111827;
        border: 1px solid rgba(148, 163, 184, 0.16);
        color: #cbd5e1;
        border-radius: 10px;
        padding: 20px;
    }
</style>

<div class="container mt-4 impact-page">

    <div class="d-flex justify-content-between align-items-center impact-header">
        <div>
            <h2 class="impact-title">
                User Impact Classification
            </h2>

            <p class="impact-subtitle">
                Release @Model.VersionNumber
            </p>
        </div>

        <a asp-action="Index" class="back-btn">
            ← Back to Releases
        </a>
    </div>

    @if (!Model.Items.Any())
    {
        <div class="empty-impact">
            No release items are available for impact classification.
        </div>
    }
    else
    {
        <div class="impact-card">

            <div class="impact-card-header">
                <strong>Classified Release Items</strong>
            </div>

            <div class="table-responsive">

                <table class="impact-table">

                    <thead>
                        <tr>
                            <th>Evidence</th>
                            <th>Release Item</th>
                            <th>Impact</th>
                            <th>Reason</th>
                            <th>Affected Users</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model.Items)
                        {
                            <tr>

                                <td>
                                    <span class="evidence-badge">
                                        @item.EvidenceCode
                                    </span>
                                </td>

                                <td>
                                    <span class="release-title">
                                        @item.Title
                                    </span>
                                </td>

                                <td>

                                    @if (item.Classification == "High")
                                    {
                                        <span class="impact-badge impact-high">
                                            High
                                        </span>
                                    }
                                    else if (item.Classification == "Medium")
                                    {
                                        <span class="impact-badge impact-medium">
                                            Medium
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="impact-badge impact-low">
                                            Low
                                        </span>
                                    }

                                </td>

                                <td>
                                    <span class="reason-text">
                                        @item.Reason
                                    </span>
                                </td>

                                <td>

                                    @if (string.IsNullOrWhiteSpace(item.AffectedUsers))
                                    {
                                        <span class="not-specified">
                                            Not specified
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="affected-users">
                                            @item.AffectedUsers
                                        </span>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        </div>
    }

</div>