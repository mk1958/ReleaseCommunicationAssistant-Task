@model ReleaseCommunicationAssistant_Task.Models.Release

@{
    ViewData["Title"] = "Release Details";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        background: radial-gradient(circle at 10% 10%, rgba(14,165,233,.14), transparent 28%), radial-gradient(circle at 90% 20%, rgba(139,92,246,.14), transparent 30%), linear-gradient(135deg,#07111f,#0f172a 55%,#172554);
        min-height: 100vh;
    }

    .details-page {
        min-height: calc(100vh - 70px);
        padding: 35px;
    }

    .details-header {
        background: linear-gradient(135deg,#0f172a,#164e63,#312e81);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 22px;
        padding: 30px;
        color: white;
        margin-bottom: 25px;
        box-shadow: 0 20px 45px rgba(0,0,0,.25);
    }

    .details-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: rgba(56,189,248,.12);
        border: 1px solid rgba(125,211,252,.25);
        color: #7dd3fc;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 12px;
    }

    .details-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
    }

    .details-header p {
        margin: 8px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    .details-card {
        max-width: 1000px;
        margin: auto;
        background: rgba(15,23,42,.92);
        border: 1px solid rgba(148,163,184,.14);
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
    }

    .section {
        margin-bottom: 30px;
    }

    .section-title {
        color: #f8fafc;
        font-size: 17px;
        font-weight: 750;
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(148,163,184,.12);
    }

        .section-title span {
            color: #38bdf8;
            margin-right: 8px;
        }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 15px;
    }

    .info-box {
        background: #0b1220;
        border: 1px solid #1e293b;
        border-radius: 10px;
        padding: 16px;
    }

    .info-label {
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 7px;
    }

    .info-value {
        color: #e2e8f0;
        font-size: 14px;
        font-weight: 600;
        word-break: break-word;
    }

    .status {
        display: inline-flex;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 750;
    }

    .approved {
        background: rgba(34,197,94,.12);
        color: #4ade80;
    }

    .review {
        background: rgba(245,158,11,.12);
        color: #fbbf24;
    }

    .rejected {
        background: rgba(239,68,68,.12);
        color: #f87171;
    }

    .draft {
        background: rgba(148,163,184,.12);
        color: #cbd5e1;
    }

    .button-row {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 20px;
        border-top: 1px solid rgba(148,163,184,.12);
    }

    .btn {
        display: inline-block;
        padding: 11px 18px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 750;
        transition: .2s;
    }

    .btn-primary {
        background: linear-gradient(135deg,#0284c7,#4f46e5);
        color: white;
    }

    .btn-secondary {
        background: #1e293b;
        color: #cbd5e1;
        border: 1px solid #334155;
    }

    .btn-danger {
        background: rgba(239,68,68,.12);
        color: #f87171;
        border: 1px solid rgba(239,68,68,.20);
    }

    .btn:hover {
        transform: translateY(-2px);
    }

    @@media (max-width: 700px) {

        .details-page {
            padding: 18px;
        }

        .details-card {
            padding: 20px;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .button-row {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>


<div class="details-page">

    <!-- HEADER -->

    <div class="details-header">

        <span class="details-badge">
            Release Management
        </span>

        <h1>
            Release Details
        </h1>

        <p>
            View the details of this release package.
        </p>

    </div>


    <!-- CONTENT -->

    <div class="details-card">

        <!-- RELEASE INFORMATION -->

        <div class="section">

            <div class="section-title">
                <span>01</span>
                Release Information
            </div>

            <div class="info-grid">

                <div class="info-box">

                    <div class="info-label">
                        Release ID
                    </div>

                    <div class="info-value">
                        @Model.ReleaseId
                    </div>

                </div>


                <div class="info-box">

                    <div class="info-label">
                        Version Number
                    </div>

                    <div class="info-value">
                        @Model.VersionNumber
                    </div>

                </div>


                <div class="info-box">

                    <div class="info-label">
                        Status
                    </div>

                    <div class="info-value">

                        @if (Model.Status == "Approved")
                        {
                            <span class="status approved">
                                Approved
                            </span>
                        }
                        else if (Model.Status == "Review")
                        {
                            <span class="status review">
                                Review
                            </span>
                        }
                        else if (Model.Status == "Rejected")
                        {
                            <span class="status rejected">
                                Rejected
                            </span>
                        }
                        else
                        {
                            <span class="status draft">
                                @(string.IsNullOrWhiteSpace(Model.Status)
                                                            ? "Draft"
                                                            : Model.Status)
                        </span>
                                                }

                    </div>

                </div>

            </div>

        </div>


        <!-- RECORD INFORMATION -->

        <div class="section">

            <div class="section-title">
                <span>02</span>
                Record Information
            </div>

            <div class="info-grid">

                <div class="info-box">

                    <div class="info-label">
                        Created At
                    </div>

                    <div class="info-value">
                        @Model.CreatedAt
                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="button-row">

            <a asp-action="Index"
               class="btn btn-secondary">
                ← Back
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.ReleaseId"
               class="btn btn-primary">
                ✎ Edit
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.ReleaseId"
               class="btn btn-danger">
                × Delete
            </a>

        </div>

    </div>

</div>