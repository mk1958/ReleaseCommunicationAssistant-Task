@model ReleaseCommunicationAssistant_Task.Models.FinalReleaseBriefViewModel

@{
    ViewData["Title"] = "Final Release Brief";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 style="color:#f8fafc;">📄 Final Release Brief</h1>
            <p style="color:#94a3b8;">
                Reviewed release communication for version
                <strong style="color:#60a5fa;">
                    @Model.VersionNumber
                </strong>
            </p>
        </div>

        <a asp-controller="Releases"
           asp-action="Index"
           class="btn btn-outline-light">
            ← Back to Releases
        </a>
    </div>

    <!-- REVIEW STATUS -->
    @if (Model.HasStaleStatements || Model.HasUnapprovedStatements)
    {
        <div class="alert alert-warning"
             style="background:rgba(245,158,11,.10);
                        border:1px solid rgba(245,158,11,.30);
                        color:#fbbf24;">

            <strong>⚠ Review Required</strong>

            @if (Model.HasStaleStatements)
            {
                <div class="mt-2">
                    Some generated statements are stale and must be reviewed again.
                </div>
            }

            @if (Model.HasUnapprovedStatements)
            {
                <div class="mt-1">
                    Some generated statements have not been approved or edited.
                </div>
            }
        </div>
    }
    else
    {
        <div class="alert alert-success"
             style="background:rgba(34,197,94,.10);
                        border:1px solid rgba(34,197,94,.25);
                        color:#4ade80;">

            <strong>✓ Review Complete</strong>

            <div class="mt-1">
                All generated statements included in this brief have been reviewed.
            </div>
        </div>
    }

    <!-- RELEASE INFORMATION -->
    <div class="card p-4 mb-4"
         style="background:#111827;
                border:1px solid #1f2937;
                border-radius:14px;">

        <h3 style="color:#f8fafc;">📌 Release Information</h3>

        <div class="row mt-3">

            <div class="col-md-4">
                <div style="color:#94a3b8;">Version</div>
                <div style="color:#f8fafc;font-size:20px;">
                    @Model.VersionNumber
                </div>
            </div>

            <div class="col-md-4">
                <div style="color:#94a3b8;">Release Status</div>
                <div style="color:#f8fafc;font-size:20px;">
                    @Model.Status
                </div>
            </div>

            <div class="col-md-4">
                <div style="color:#94a3b8;">Release ID</div>
                <div style="color:#f8fafc;font-size:20px;">
                    @Model.ReleaseId
                </div>
            </div>

        </div>
    </div>

    <!-- TECHNICAL SUMMARY -->
    <div class="card p-4 mb-4"
         style="background:#111827;
                border:1px solid #1f2937;
                border-radius:14px;">

        <h3 style="color:#60a5fa;">
            🛠 Internal Technical Summary
        </h3>

        <div class="mt-3"
             style="white-space:pre-line;
                    color:#cbd5e1;
                    line-height:1.7;">
            @Model.TechnicalSummary
        </div>

    </div>

    <!-- STAKEHOLDER SUMMARY -->
    <div class="card p-4 mb-4"
         style="background:#111827;
                border:1px solid #1f2937;
                border-radius:14px;">

        <h3 style="color:#34d399;">
            👥 Nontechnical Stakeholder Summary
        </h3>

        <div class="mt-3"
             style="white-space:pre-line;
                    color:#cbd5e1;
                    line-height:1.7;">
            @Model.StakeholderSummary
        </div>

    </div>

    <!-- REVIEWED STATEMENTS -->
    <div class="card p-4 mb-4"
         style="background:#111827;
                border:1px solid #1f2937;
                border-radius:14px;">

        <h3 style="color:#c084fc;">
            ✓ Reviewed Statements
        </h3>

        @if (Model.ReviewedStatements.Any())
        {
            @foreach (var statement in Model.ReviewedStatements)
            {
                <div class="p-3 mt-3"
                     style="background:#0f172a;
                                    border-radius:10px;
                                    border:1px solid #1e293b;">

                    <div class="d-flex justify-content-between">

                        <strong style="color:#f8fafc;">
                            @statement.StatementCode
                        </strong>

                        @if (statement.Status == "Approved")
                        {
                            <span style="color:#4ade80;">
                                ✓ Approved
                            </span>
                        }
                        else
                        {
                            <span style="color:#60a5fa;">
                                ✎ Edited
                            </span>
                        }

                    </div>

                    <div style="color:#94a3b8;margin-top:8px;">
                        Audience:
                        @statement.Audience
                    </div>

                    <div style="color:#94a3b8;">
                        Type:
                        @statement.StatementType
                    </div>

                    <div class="mt-3"
                         style="color:#cbd5e1;line-height:1.6;">
                        @statement.StatementText
                    </div>

                    @if (!string.IsNullOrWhiteSpace(statement.EvidenceReferences))
                    {
                        <div class="mt-3"
                             style="color:#60a5fa;">
                            Evidence:
                            @statement.EvidenceReferences
                        </div>
                    }

                </div>
            }
        }
        else
        {
            <div class="mt-3"
                 style="color:#fbbf24;">
                No approved or edited generated statements are currently available.
            </div>
        }

    </div>

    <!-- EVIDENCE -->
    <div class="card p-4 mb-4"
         style="background:#111827;
                border:1px solid #1f2937;
                border-radius:14px;">

        <h3 style="color:#60a5fa;">
            🔎 Supporting Evidence
        </h3>

        @if (Model.EvidenceReferences.Any())
        {
            <div class="mt-3">
                @foreach (var evidence in Model.EvidenceReferences.Distinct())
                {
                    <span class="badge me-2 mb-2"
                          style="background:rgba(59,130,246,.15);
                                         color:#60a5fa;
                                         border:1px solid rgba(59,130,246,.25);
                                         padding:8px 12px;">
                        @evidence
                    </span>
                }
            </div>
        }
        else
        {
            <p style="color:#94a3b8;margin-top:15px;">
                No evidence references are available.
            </p>
        }

    </div>

    <!-- RISKS -->
    <div class="card p-4 mb-4"
         style="background:#111827;
                border:1px solid #1f2937;
                border-radius:14px;">

        <h3 style="color:#f87171;">
            ⚠ Risks
        </h3>

        @if (Model.Risks.Any())
        {
            <ul class="mt-3">
                @foreach (var risk in Model.Risks)
                {
                    <li style="color:#fca5a5;margin-bottom:8px;">
                        @risk
                    </li>
                }
            </ul>
        }
        else
        {
            <p style="color:#94a3b8;margin-top:15px;">
                No deterministic risk indicators were detected.
            </p>
        }

    </div>

    <!-- LIMITATIONS -->
    <div class="card p-4 mb-4"
         style="background:#111827;
                border:1px solid #1f2937;
                border-radius:14px;">

        <h3 style="color:#fbbf24;">
            ⚠ Known Limitations
        </h3>

        @if (Model.Limitations.Any())
        {
            <ul class="mt-3">
                @foreach (var limitation in Model.Limitations)
                {
                    <li style="color:#fde68a;margin-bottom:8px;">
                        @limitation
                    </li>
                }
            </ul>
        }
        else
        {
            <p style="color:#94a3b8;margin-top:15px;">
                No deterministic limitation indicators were detected.
            </p>
        }

    </div>

    <!-- FINAL NOTICE -->
    <div class="card p-4"
         style="background:rgba(59,130,246,.07);
                border:1px solid rgba(59,130,246,.20);
                border-radius:14px;">

        <h4 style="color:#60a5fa;">
            ℹ Review Boundary
        </h4>

        <p style="color:#cbd5e1;margin-bottom:0;">
            This brief contains release communication generated from the supplied
            release package, QA evidence, and reviewed statements.
            It does not deploy software or mark a release as approved for deployment.
        </p>

    </div>

</div>