@model ReleaseCommunicationAssistant_Task.Models.Release

@{
    ViewData["Title"] = "Edit Release";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        background: radial-gradient(circle at 10% 10%, rgba(14,165,233,.14), transparent 28%), radial-gradient(circle at 90% 20%, rgba(139,92,246,.14), transparent 30%), linear-gradient(135deg,#07111f,#0f172a 55%,#172554);
        min-height: 100vh;
    }

    .edit-page {
        min-height: calc(100vh - 70px);
        padding: 35px;
    }

    .edit-header {
        background: linear-gradient(135deg,#0f172a,#164e63,#312e81);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 22px;
        padding: 30px;
        color: white;
        margin-bottom: 25px;
        box-shadow: 0 20px 45px rgba(0,0,0,.25);
    }

    .edit-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: rgba(56,189,248,.12);
        border: 1px solid rgba(125,211,252,.25);
        color: #7dd3fc;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 12px;
    }

    .edit-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
    }

    .edit-header p {
        margin: 8px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    .edit-card {
        max-width: 1000px;
        margin: auto;
        background: rgba(15,23,42,.92);
        border: 1px solid rgba(148,163,184,.14);
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
    }

    .section {
        margin-bottom: 30px;
    }

    .section-title {
        color: #f8fafc;
        font-size: 17px;
        font-weight: 750;
        margin-bottom: 18px;
        padding-bottom: 10px;
        border-bottom: 1px solid rgba(148,163,184,.12);
    }

        .section-title span {
            color: #38bdf8;
            margin-right: 8px;
        }

    .form-group {
        margin-bottom: 18px;
    }

    label {
        display: block;
        color: #cbd5e1;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .form-control,
    .form-select {
        width: 100%;
        padding: 11px 13px;
        border-radius: 9px;
        border: 1px solid #334155;
        background: #0f172a;
        color: #e2e8f0;
        font-size: 13px;
        outline: none;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #38bdf8;
            box-shadow: 0 0 0 3px rgba(56,189,248,.08);
        }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .readonly {
        background: #020617;
        color: #94a3b8;
    }

    .validation {
        color: #f87171;
        font-size: 11px;
        margin-top: 5px;
    }

    .button-row {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 20px;
        border-top: 1px solid rgba(148,163,184,.12);
    }

    .btn {
        border: none;
        border-radius: 9px;
        padding: 11px 19px;
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
        cursor: pointer;
        transition: .2s;
    }

    .btn-primary {
        background: linear-gradient(135deg,#0284c7,#4f46e5);
        color: white;
    }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(37,99,235,.25);
        }

    .btn-secondary {
        background: #1e293b;
        color: #cbd5e1;
        border: 1px solid #334155;
    }

        .btn-secondary:hover {
            background: #334155;
            color: white;
        }

    @@media (max-width: 700px) {
        .edit-page {
            padding: 18px;
        }

        .edit-card {
            padding: 20px;
        }

        .button-row {
            flex-direction: column;
        }

        .btn {
            width: 100%;
            text-align: center;
        }
    }
</style>


<div class="edit-page">

    <!-- HEADER -->

    <div class="edit-header">

        <span class="edit-badge">
            Release Management
        </span>

        <h1>
            Edit Release
        </h1>

        <p>
            Update the release package information and communication details.
        </p>

    </div>


    <!-- FORM -->

    <div class="edit-card">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="ReleaseId" />


            <!-- RELEASE INFORMATION -->

            <div class="section">

                <div class="section-title">
                    <span>01</span>
                    Release Information
                </div>


                <div class="form-group">

                    <label asp-for="VersionNumber">
                        Version Number
                    </label>

                    <input asp-for="VersionNumber"
                           class="form-control" />

                    <span asp-validation-for="VersionNumber"
                          class="validation">
                    </span>

                </div>


                <div class="form-group">

                    <label asp-for="Status">
                        Release Status
                    </label>

                    <select asp-for="Status"
                            class="form-select">

                        <option value="Draft">
                            Draft
                        </option>

                        <option value="Review">
                            Review
                        </option>

                        <option value="Approved">
                            Approved
                        </option>

                        <option value="Rejected">
                            Rejected
                        </option>

                    </select>

                    <span asp-validation-for="Status"
                          class="validation">
                    </span>

                </div>

            </div>


            <!-- RECORD INFORMATION -->

            <div class="section">

                <div class="section-title">
                    <span>02</span>
                    Record Information
                </div>


                <div class="form-group">

                    <label>
                        Release ID
                    </label>

                    <input asp-for="ReleaseId"
                           class="form-control readonly"
                           readonly />

                </div>


                <div class="form-group">

                    <label>
                        Created At
                    </label>

                    <input asp-for="CreatedAt"
                           class="form-control readonly"
                           readonly />

                </div>

            </div>


            <!-- ACTIONS -->

            <div class="button-row">

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Cancel
                </a>

                <a asp-action="Details"
                   asp-route-id="@Model.ReleaseId"
                   class="btn btn-secondary">
                    View Details
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    Save Changes
                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}