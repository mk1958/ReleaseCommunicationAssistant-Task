@model IEnumerable<ReleaseCommunicationAssistant_Task.Models.Release>

@{
    ViewData["Title"] = "Releases";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        background: radial-gradient(circle at 10% 10%, rgba(14, 165, 233, .16), transparent 28%), radial-gradient(circle at 90% 20%, rgba(139, 92, 246, .16), transparent 30%), linear-gradient(135deg, #07111f, #0f172a 55%, #172554);
        min-height: 100vh;
    }

    .release-page {
        min-height: calc(100vh - 70px);
        padding: 35px;
    }

    .release-header {
        position: relative;
        overflow: hidden;
        padding: 32px;
        border-radius: 22px;
        background: linear-gradient(135deg, #0f172a, #164e63, #312e81);
        color: white;
        margin-bottom: 25px;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
        border: 1px solid rgba(255,255,255,.08);
    }

        .release-header::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            border-radius: 50%;
            background: rgba(56,189,248,.12);
            right: -55px;
            top: -75px;
            filter: blur(4px);
        }

    .release-header-content {
        position: relative;
        z-index: 2;
    }

    .release-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: rgba(56,189,248,.12);
        border: 1px solid rgba(125,211,252,.25);
        color: #7dd3fc;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 12px;
    }

    .release-header h1 {
        margin: 0;
        font-size: 31px;
        font-weight: 800;
    }

    .release-header p {
        margin: 8px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    .release-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        background: rgba(15,23,42,.85);
        border: 1px solid rgba(148,163,184,.14);
        padding: 18px 22px;
        border-radius: 16px;
        margin-bottom: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,.18);
    }

    .toolbar-title {
        color: #f8fafc;
        font-size: 16px;
        font-weight: 750;
    }

    .toolbar-subtitle {
        color: #94a3b8;
        font-size: 12px;
        margin-top: 4px;
    }

    .create-btn {
        background: linear-gradient(135deg, #0284c7, #4f46e5);
        color: white !important;
        padding: 10px 18px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        transition: .25s;
        box-shadow: 0 8px 18px rgba(37,99,235,.22);
    }

        .create-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 25px rgba(37,99,235,.32);
        }

    .release-card {
        background: rgba(15,23,42,.88);
        border: 1px solid rgba(148,163,184,.14);
        border-radius: 19px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0,0,0,.25);
    }

    .table-scroll {
        overflow-x: auto;
    }

    .release-table {
        width: 100%;
        min-width: 1250px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .release-table thead {
            background: rgba(30,41,59,.95);
        }

        .release-table th {
            padding: 15px;
            color: #94a3b8;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .06em;
            white-space: nowrap;
            border-bottom: 1px solid rgba(148,163,184,.14);
        }

        .release-table td {
            padding: 16px;
            color: #cbd5e1;
            font-size: 13px;
            border-bottom: 1px solid rgba(148,163,184,.08);
            vertical-align: middle;
        }

        .release-table tbody tr {
            transition: .18s;
        }

            .release-table tbody tr:hover {
                background: rgba(56,189,248,.045);
            }

            .release-table tbody tr:last-child td {
                border-bottom: none;
            }

    .version {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 7px;
        background: rgba(99,102,241,.13);
        color: #a5b4fc;
        border: 1px solid rgba(99,102,241,.15);
        font-family: Consolas, monospace;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .release-content {
        max-width: 260px;
        color: #94a3b8;
        line-height: 1.5;
        font-size: 12px;
    }

        .release-content strong {
            color: #e2e8f0;
            display: block;
            margin-bottom: 3px;
        }

    .status {
        display: inline-flex;
        padding: 6px 11px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 750;
    }

    .status-draft {
        background: rgba(148,163,184,.12);
        color: #cbd5e1;
        border: 1px solid rgba(148,163,184,.15);
    }

    .status-review {
        background: rgba(245,158,11,.12);
        color: #fbbf24;
        border: 1px solid rgba(245,158,11,.15);
    }

    .status-approved {
        background: rgba(34,197,94,.12);
        color: #4ade80;
        border: 1px solid rgba(34,197,94,.15);
    }

    .status-rejected {
        background: rgba(239,68,68,.12);
        color: #f87171;
        border: 1px solid rgba(239,68,68,.15);
    }

    .release-date {
        white-space: nowrap;
        color: #94a3b8;
        font-size: 11px;
    }

    /* =========================
           ACTION PANEL
           ========================= */

    .actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(115px, 1fr));
        gap: 8px;
        width: 390px;
        padding: 4px;
    }

    .action-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        min-height: 38px;
        text-align: center;
        padding: 8px 7px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 10.5px;
        font-weight: 700;
        line-height: 1.2;
        transition: .2s;
        white-space: normal;
    }

        .action-btn:hover {
            transform: translateY(-2px);
            filter: brightness(1.15);
        }

    .edit-btn {
        background: rgba(59,130,246,.12);
        color: #60a5fa;
        border: 1px solid rgba(59,130,246,.15);
    }

    .details-btn {
        background: rgba(34,197,94,.10);
        color: #4ade80;
        border: 1px solid rgba(34,197,94,.15);
    }

    .readiness-btn {
        background: rgba(245,158,11,.10);
        color: #fbbf24;
        border: 1px solid rgba(245,158,11,.15);
    }

    .risks-btn {
        background: rgba(220,53,69,.10);
        color: #ff6b6b;
        border: 1px solid rgba(220,53,69,.20);
    }

    .delete-btn {
        background: rgba(239,68,68,.10);
        color: #f87171;
        border: 1px solid rgba(239,68,68,.15);
    }

    .technical-btn {
        background: rgba(59,130,246,.10);
        color: #60a5fa;
        border: 1px solid rgba(59,130,246,.15);
    }

    .compare-btn {
        background: rgba(168,85,247,.10);
        color: #c084fc;
        border: 1px solid rgba(168,85,247,.20);
    }

    .brief-btn {
        background: rgba(16,185,129,.10);
        color: #34d399;
        border: 1px solid rgba(16,185,129,.20);
    }

    .impact-btn {
        background: rgba(16,130,246,.10);
        color: #60a5fa;
        border: 1px solid rgba(59,130,246,.20);
    }

    .history-btn {
        background: rgba(168,85,247,.10);
        color: #c084fc;
        border: 1px solid rgba(168,85,247,.20);
    }

    .ai-btn {
        background: rgba(239,68,68,.10);
        color: #f87171;
        border: 1px solid rgba(239,68,68,.20);
    }

    .ai-missing-btn {
        background: rgba(14,165,233,.10);
        color: #38bdf8;
        border: 1px solid rgba(14,165,233,.20);
    }

    .empty-state {
        text-align: center;
        padding: 70px 20px;
        color: #94a3b8;
    }

        .empty-state h3 {
            color: #f8fafc;
            margin-bottom: 8px;
        }

    /* =========================
           RESPONSIVE
           ========================= */

    @@media (max-width: 700px) {

        .release-page {
            padding: 18px;
        }

        .release-toolbar {
            flex-direction: column;
            align-items: flex-start;
        }

        .release-header h1 {
            font-size: 25px;
        }

        .actions {
            grid-template-columns: repeat(2, minmax(110px, 1fr));
            width: 250px;
        }

        .release-table {
            min-width: 1050px;
        }
    }
</style>


<div class="release-page">

    <!-- HEADER -->

    <div class="release-header">

        <div class="release-header-content">

            <span class="release-badge">
                Release Management
            </span>

            <h1>
                Releases
            </h1>

            <p>
                Manage release packages and release communication information.
            </p>

        </div>

    </div>


    <!-- TOOLBAR -->

    <div class="release-toolbar">

        <div>

            <div class="toolbar-title">
                Release Packages
            </div>

            <div class="toolbar-subtitle">
                Review and manage your application releases.
            </div>

        </div>

        <a asp-controller="Releases"
           asp-action="Create"
           class="create-btn">
            + Create Release
        </a>

    </div>


    <!-- TABLE -->

    <div class="release-card">

        <div class="table-scroll">

            @if (Model != null && Model.Any())
            {
                <table class="release-table">

                    <thead>

                        <tr>

                            <th>
                                Version
                            </th>

                            <th>
                                Release Information
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Created
                            </th>

                            <th>
                                Actions
                            </th>

                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- VERSION -->

                                <td>

                                    <span class="version">
                                        @item.VersionNumber
                                    </span>

                                </td>


                                <!-- RELEASE INFORMATION -->

                                <td>

                                    <div class="release-content">

                                        <strong>
                                            Release Package
                                        </strong>

                                        <span>
                                            Release ID: @item.ReleaseId
                                        </span>

                                        <br />

                                        <span>
                                            Release version @item.VersionNumber
                                        </span>

                                    </div>

                                </td>


                                <!-- STATUS -->

                                <td>

                                    @if (item.Status == "Approved")
                                    {
                                        <span class="status status-approved">
                                            Approved
                                        </span>
                                    }
                                    else if (item.Status == "Review")
                                    {
                                        <span class="status status-review">
                                            Review
                                        </span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="status status-rejected">
                                            Rejected
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status status-draft">
                                            @(string.IsNullOrWhiteSpace(item.Status)
                                                                            ? "Draft"
                                                                            : item.Status)
                            </span>
                                                        }

                                </td>


                                <!-- CREATED -->

                                <td>

                                    <span class="release-date">
                                        @item.CreatedAt
                                    </span>

                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="actions">

                                        <a asp-controller="Releases"
                                           asp-action="Edit"
                                           asp-route-id="@item.ReleaseId"
                                           class="action-btn edit-btn">
                                            ✎ Edit
                                        </a>

                                        <a asp-controller="Releases"
                                           asp-action="Details"
                                           asp-route-id="@item.ReleaseId"
                                           class="action-btn details-btn">
                                            ◉ Details
                                        </a>

                                        <a asp-controller="Releases"
                                           asp-action="Readiness"
                                           asp-route-id="@item.ReleaseId"
                                           class="action-btn readiness-btn">
                                            ✓ Readiness
                                        </a>

                                        <a asp-controller="Releases"
                                           asp-action="Risks"
                                           asp-route-id="@item.ReleaseId"
                                           class="action-btn risks-btn">
                                            ⚠ Risks
                                        </a>

                                        <a asp-controller="Releases"
                                           asp-action="Delete"
                                           asp-route-id="@item.ReleaseId"
                                           class="action-btn delete-btn">
                                            × Delete
                                        </a>

                                        <a asp-controller="Releases"
                                           asp-action="TechnicalSummary"
                                           asp-route-id="@item.ReleaseId"
                                           class="action-btn technical-btn">
                                            📝 Technical Summary
                                        </a>

                                        <a asp-controller="Releases"
                                           asp-action="Compare"
                                           class="action-btn compare-btn">
                                            🔄 Compare Versions
                                        </a>

                                        <a asp-controller="Releases"
                                           asp-action="FinalBrief"
                                           asp-route-id="@item.ReleaseId"
                                           class="action-btn brief-btn">
                                            📄 Final Brief
                                        </a>

                                        <a asp-controller="Releases"
                                           asp-action="UserImpact"
                                           asp-route-id="@item.ReleaseId"
                                           class="action-btn impact-btn">
                                            👥 User Impact
                                        </a>

                                        <a asp-controller="Releases"
                                           asp-action="VersionHistory"
                                           asp-route-id="@item.ReleaseId"
                                           class="action-btn history-btn">
                                            🕘 Version History
                                        </a>

                                        <a asp-controller="Releases"
                                           asp-action="AiUnsupportedClaims"
                                           asp-route-id="@item.ReleaseId"
                                           class="action-btn ai-btn">
                                            ⚠ AI Unsupported Claims
                                        </a>

                                        <a asp-controller="Releases"
                                           asp-action="AiMissingInformation"
                                           asp-route-id="@item.ReleaseId"
                                           class="action-btn ai-missing-btn">
                                            ✨ AI Missing Information
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            }
            else
            {
                <div class="empty-state">

                    <h3>
                        No Releases
                    </h3>

                    <p>
                        No release packages have been created yet.
                    </p>

                    <a asp-controller="Releases"
                       asp-action="Create"
                       class="create-btn">
                        + Create Release
                    </a>

                </div>
            }

        </div>

    </div>

</div>