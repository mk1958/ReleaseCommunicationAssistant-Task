@model ReleaseCommunicationAssistant_Task.Models.Qaevidence

@{
    ViewData["Title"] = "QA Evidence Details";
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        background: radial-gradient(circle at 10% 10%, rgba(14, 165, 233, .16), transparent 28%), radial-gradient(circle at 90% 20%, rgba(139, 92, 246, .16), transparent 30%), linear-gradient(135deg, #07111f, #0f172a 55%, #172554);
        min-height: 100vh;
    }

    .qa-details-page {
        min-height: calc(100vh - 70px);
        padding: 35px;
    }

    /* HEADER */

    .qa-details-header {
        position: relative;
        overflow: hidden;
        padding: 32px;
        border-radius: 22px;
        background: linear-gradient( 135deg, #0f172a, #164e63, #312e81 );
        color: white;
        margin-bottom: 25px;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
        border: 1px solid rgba(255,255,255,.08);
    }

        .qa-details-header::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            border-radius: 50%;
            background: rgba(56,189,248,.12);
            right: -55px;
            top: -75px;
            filter: blur(4px);
        }

    .qa-details-header-content {
        position: relative;
        z-index: 2;
    }

    .qa-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        background: rgba(56,189,248,.12);
        border: 1px solid rgba(125,211,252,.25);
        color: #7dd3fc;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 12px;
    }

    .qa-details-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 800;
    }

    .qa-details-header p {
        margin: 8px 0 0;
        color: #cbd5e1;
        font-size: 14px;
    }

    /* MAIN CARD */

    .details-card {
        background: rgba(15,23,42,.90);
        border: 1px solid rgba(148,163,184,.14);
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 15px 40px rgba(0,0,0,.25);
    }

    /* SECTION */

    .details-section {
        margin-bottom: 30px;
    }

        .details-section:last-of-type {
            margin-bottom: 10px;
        }

    .section-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(148,163,184,.12);
    }

    .section-number {
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: linear-gradient(135deg, #0284c7, #4f46e5);
        color: white;
        font-size: 11px;
        font-weight: 800;
    }

    .section-title {
        color: #f8fafc;
        font-size: 16px;
        font-weight: 750;
    }

    .section-subtitle {
        color: #64748b;
        font-size: 11px;
        margin-top: 2px;
    }

    /* INFO GRID */

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .info-item {
        background: rgba(30,41,59,.55);
        border: 1px solid rgba(148,163,184,.10);
        border-radius: 12px;
        padding: 16px;
        min-height: 80px;
    }

    .info-label {
        color: #64748b;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 8px;
    }

    .info-value {
        color: #f8fafc;
        font-size: 14px;
        font-weight: 600;
        word-break: break-word;
    }

        .info-value.muted {
            color: #94a3b8;
            font-weight: 500;
        }

    .full-width {
        grid-column: 1 / -1;
    }

    /* EVIDENCE CODE */

    .evidence-code {
        display: inline-block;
        padding: 7px 11px;
        border-radius: 7px;
        background: rgba(99,102,241,.13);
        color: #a5b4fc;
        border: 1px solid rgba(99,102,241,.15);
        font-family: Consolas, monospace;
        font-size: 12px;
        font-weight: 700;
    }

    /* RELEASE */

    .release-id {
        display: inline-block;
        padding: 6px 11px;
        border-radius: 20px;
        background: rgba(59,130,246,.12);
        color: #60a5fa;
        border: 1px solid rgba(59,130,246,.15);
        font-size: 11px;
        font-weight: 700;
    }

    /* RESULT */

    .result {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 7px 13px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 750;
    }

    .result-passed {
        background: rgba(34,197,94,.12);
        color: #4ade80;
        border: 1px solid rgba(34,197,94,.15);
    }

    .result-failed {
        background: rgba(239,68,68,.12);
        color: #f87171;
        border: 1px solid rgba(239,68,68,.15);
    }

    .result-partial {
        background: rgba(245,158,11,.12);
        color: #fbbf24;
        border: 1px solid rgba(245,158,11,.15);
    }

    .result-not-tested {
        background: rgba(148,163,184,.12);
        color: #cbd5e1;
        border: 1px solid rgba(148,163,184,.15);
    }

    /* DESCRIPTION */

    .description-box {
        background: rgba(15,23,42,.65);
        border: 1px solid rgba(148,163,184,.10);
        border-radius: 12px;
        padding: 18px;
        color: #cbd5e1;
        font-size: 13px;
        line-height: 1.7;
        white-space: pre-wrap;
    }

    /* DATE */

    .date-value {
        color: #94a3b8;
        font-size: 13px;
    }

    /* ACTIONS */

    .details-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding-top: 22px;
        margin-top: 10px;
        border-top: 1px solid rgba(148,163,184,.12);
    }

    .left-actions {
        display: flex;
        gap: 10px;
    }

    .btn-edit {
        display: inline-block;
        text-decoration: none;
        background: rgba(59,130,246,.12);
        color: #60a5fa;
        border: 1px solid rgba(59,130,246,.18);
        padding: 10px 18px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
        transition: .2s;
    }

        .btn-edit:hover {
            background: rgba(59,130,246,.22);
            color: #93c5fd;
            transform: translateY(-1px);
        }

    .btn-delete {
        display: inline-block;
        text-decoration: none;
        background: rgba(239,68,68,.10);
        color: #f87171;
        border: 1px solid rgba(239,68,68,.16);
        padding: 10px 18px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
        transition: .2s;
    }

        .btn-delete:hover {
            background: rgba(239,68,68,.18);
            color: #fca5a5;
        }

    .btn-back {
        display: inline-block;
        text-decoration: none;
        color: #cbd5e1;
        background: rgba(51,65,85,.55);
        border: 1px solid rgba(148,163,184,.18);
        padding: 10px 18px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
        transition: .2s;
    }

        .btn-back:hover {
            color: white;
            background: rgba(71,85,105,.70);
            transform: translateY(-1px);
        }

    /* RESPONSIVE */

    @@media (max-width: 768px) {

        .qa-details-page {
            padding: 18px;
        }

        .details-card {
            padding: 20px;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .full-width {
            grid-column: auto;
        }

        .details-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .left-actions {
            width: 100%;
            flex-direction: column;
        }

        .btn-edit,
        .btn-delete,
        .btn-back {
            text-align: center;
        }

        .qa-details-header h1 {
            font-size: 25px;
        }
    }
</style>


<div class="qa-details-page">

    <!-- HEADER -->

    <div class="qa-details-header">

        <div class="qa-details-header-content">

            <span class="qa-badge">
                Release Quality
            </span>

            <h1>
                QA Evidence Details
            </h1>

            <p>
                Review complete testing evidence and validation information for this release.
            </p>

        </div>

    </div>


    <!-- DETAILS CARD -->

    <div class="details-card">


        <!-- SECTION 01 -->

        <div class="details-section">

            <div class="section-header">

                <div class="section-number">
                    01
                </div>

                <div>
                    <div class="section-title">
                        Release Information
                    </div>

                    <div class="section-subtitle">
                        Release and evidence identification.
                    </div>
                </div>

            </div>


            <div class="info-grid">

                <div class="info-item">

                    <div class="info-label">
                        QA Evidence ID
                    </div>

                    <div class="info-value">
                        #@Model.QaevidenceId
                    </div>

                </div>


                <div class="info-item">

                    <div class="info-label">
                        Release ID
                    </div>

                    <div class="info-value">
                        <span class="release-id">
                            Release #@Model.ReleaseId
                        </span>
                    </div>

                </div>


                <div class="info-item">

                    <div class="info-label">
                        Evidence Code
                    </div>

                    <div class="info-value">
                        <span class="evidence-code">
                            @Model.EvidenceCode
                        </span>
                    </div>

                </div>


                <div class="info-item">

                    <div class="info-label">
                        Test Area
                    </div>

                    <div class="info-value">
                        @Model.TestArea
                    </div>

                </div>

            </div>

        </div>


        <!-- SECTION 02 -->

        <div class="details-section">

            <div class="section-header">

                <div class="section-number">
                    02
                </div>

                <div>
                    <div class="section-title">
                        Evidence Description
                    </div>

                    <div class="section-subtitle">
                        Details of the testing performed.
                    </div>
                </div>

            </div>


            <div class="description-box">

                @if (!string.IsNullOrWhiteSpace(Model.EvidenceDescription))
                {
                    @Model.EvidenceDescription
                }
                else
                {
                    <span style="color:#64748b;">
                        No evidence description provided.
                    </span>
                }

            </div>

        </div>


        <!-- SECTION 03 -->

        <div class="details-section">

            <div class="section-header">

                <div class="section-number">
                    03
                </div>

                <div>
                    <div class="section-title">
                        Test Result
                    </div>

                    <div class="section-subtitle">
                        Current QA validation outcome.
                    </div>
                </div>

            </div>


            <div class="info-grid">

                <div class="info-item">

                    <div class="info-label">
                        Result
                    </div>

                    <div class="info-value">

                        @if (Model.Result == "Passed")
                        {
                            <span class="result result-passed">
                                ✓ Passed
                            </span>
                        }
                        else if (Model.Result == "Failed")
                        {
                            <span class="result result-failed">
                                ✕ Failed
                            </span>
                        }
                        else if (Model.Result == "Partial")
                        {
                            <span class="result result-partial">
                                ⚠ Partial
                            </span>
                        }
                        else
                        {
                            <span class="result result-not-tested">
                                ○ Not Tested
                            </span>
                        }

                    </div>

                </div>


                <div class="info-item">

                    <div class="info-label">
                        Test Date
                    </div>

                    <div class="info-value">

                        @if (Model.TestDate != null)
                        {
                            <span class="date-value">
                                @Model.TestDate
                            </span>
                        }
                        else
                        {
                            <span class="info-value muted">
                                Not specified
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- SECTION 04 -->

        <div class="details-section">

            <div class="section-header">

                <div class="section-number">
                    04
                </div>

                <div>
                    <div class="section-title">
                        Record Information
                    </div>

                    <div class="section-subtitle">
                        System information associated with this QA evidence.
                    </div>
                </div>

            </div>


            <div class="info-grid">

                <div class="info-item">

                    <div class="info-label">
                        Created At
                    </div>

                    <div class="info-value">

                        @if (Model.CreatedAt != null)
                        {
                            <span class="date-value">
                                @Model.CreatedAt
                            </span>
                        }
                        else
                        {
                            <span class="info-value muted">
                                Not available
                            </span>
                        }

                    </div>

                </div>


                <div class="info-item">

                    <div class="info-label">
                        Evidence Status
                    </div>

                    <div class="info-value">

                        @if (Model.Result == "Passed")
                        {
                            <span class="result result-passed">
                                Validated
                            </span>
                        }
                        else if (Model.Result == "Failed")
                        {
                            <span class="result result-failed">
                                Requires Attention
                            </span>
                        }
                        else
                        {
                            <span class="result result-not-tested">
                                Review Required
                            </span>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="details-actions">

            <div class="left-actions">

                <a asp-controller="Qaevidences"
                   asp-action="Index"
                   class="btn-back">
                    ← Back to QA Evidence
                </a>

                <a asp-controller="Qaevidences"
                   asp-action="Delete"
                   asp-route-id="@Model.QaevidenceId"
                   class="btn-delete">
                    × Delete
                </a>

            </div>


            <a asp-controller="Qaevidences"
               asp-action="Edit"
               asp-route-id="@Model.QaevidenceId"
               class="btn-edit">
                ✎ Edit Evidence
            </a>

        </div>

    </div>

</div>