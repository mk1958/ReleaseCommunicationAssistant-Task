@model ReleaseCommunicationAssistant_Task.Models.QaClaimCheckViewModel

@{
    ViewData["Title"] = "QA Claim Check";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-white fw-bold mb-1">
                QA Claim Check
            </h1>

            <p class="text-secondary mb-0">
                Checks whether the supplied release claim is supported by QA evidence.
            </p>
        </div>

        <a asp-action="Index" class="btn btn-outline-light">
            ← Back to QA Evidence
        </a>
    </div>

    @if (Model.IsSupported)
    {
        <div class="alert alert-success border-0 shadow-sm">
            <strong>✓ Supported Claim</strong>
            <div class="mt-1">
                Supporting QA evidence was found for this release claim.
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-danger border-0 shadow-sm">
            <strong>⚠ Unsupported Claim</strong>
            <div class="mt-1">
                No supplied QA evidence sufficiently supports this release claim.
            </div>
        </div>
    }

    <div class="card bg-dark text-white border-secondary shadow">
        <div class="card-body p-4">

            <div class="mb-4">
                <h5 class="text-secondary">
                    Release Claim
                </h5>

                <div class="p-3 border border-secondary rounded">
                    @Model.Claim
                </div>
            </div>

            <div class="row g-4">

                <div class="col-md-6">
                    <h6 class="text-secondary">
                        Release Item
                    </h6>

                    <p class="mb-0">
                        @Model.EvidenceCode
                    </p>
                </div>

                <div class="col-md-6">
                    <h6 class="text-secondary">
                        Check Result
                    </h6>

                    @if (Model.IsSupported)
                    {
                        <span class="badge bg-success fs-6 px-3 py-2">
                            SUPPORTED
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger fs-6 px-3 py-2">
                            UNSUPPORTED
                        </span>
                    }
                </div>

            </div>

            <hr class="border-secondary my-4" />

            <div>
                <h5 class="mb-3">
                    Evidence Assessment
                </h5>

                <p class="text-secondary">
                    @Model.SupportReason
                </p>
            </div>

            @if (Model.IsSupported)
            {
                <div class="mt-4 p-4 border border-success rounded">

                    <h6 class="text-success">
                        Supporting QA Evidence
                    </h6>

                    <div class="row mt-3">

                        <div class="col-md-6">
                            <span class="text-secondary">
                                Evidence Code
                            </span>

                            <p class="mt-1">
                                @Model.EvidenceCode
                            </p>
                        </div>

                        <div class="col-md-6">
                            <span class="text-secondary">
                                Test Area
                            </span>

                            <p class="mt-1">
                                @Model.TestArea
                            </p>
                        </div>

                    </div>

                    <div class="mt-3">

                        <span class="text-secondary">
                            Evidence Description
                        </span>

                        <p class="mt-1 mb-0">
                            @Model.EvidenceDescription
                        </p>

                    </div>

                </div>
            }
            else
            {
                <div class="mt-4 p-4 border border-danger rounded">

                    <h6 class="text-danger">
                        Evidence Gap
                    </h6>

                    <p class="text-secondary mb-0">
                        The claim should not be presented as QA-validated until
                        supporting evidence is supplied.
                    </p>

                </div>
            }

        </div>
    </div>

</div>

<style>
    body {
        background: #0f1115;
    }

    .card {
        border-radius: 14px;
    }

    .badge {
        border-radius: 8px;
        letter-spacing: 0.5px;
    }
</style>